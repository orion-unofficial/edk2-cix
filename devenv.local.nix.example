# You can use devenv.local.nix to override the default settings.
# This file is provided as an example.
# Copy it to devenv.local.nix and keep any machine-specific settings there.

{ pkgs, lib, ... }:

{
  # Override rsdk defaults here
  env  =  {
    EDK2_EC_UART = "ttyCH9344USB0"; # UART1
    EDK2_SE_UART = "ttyCH9344USB1"; # UART5
    EDK2_AP_UART = "ttyCH9344USB2"; # UART2
    EDK2_DEBUG_UART = "ttyCH9344USB3"; # UART3
    DEBEMAIL = "email@example.com"; # Email in debian/changelog
    DEBFULLNAME = "\"Example Co., Ltd\""; # Full name in debian/changelog
  };

  # Optional: enable local Git hooks for this clone only.
  #
  # Keeping the hook configuration here avoids stale generated hooks being
  # imposed on every checkout that happens to enter the devenv shell.
  #
  # git-hooks = {
  #   hooks = {
  #     commitizen.enable = true;
  #     shellcheck = {
  #       enable = true;
  #       entry = lib.mkForce "${pkgs.shellcheck}/bin/shellcheck -x";
  #     };
  #     shfmt.enable = true;
  #     statix.enable = true;
  #     typos = {
  #       enable = true;
  #       excludes = [
  #         "theme/highlight.js"
  #       ];
  #       settings.ignored-words = [
  #         "Synopsys"
  #         "HSI"
  #       ];
  #     };
  #   };
  # };
}
