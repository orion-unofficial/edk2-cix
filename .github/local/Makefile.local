LOCAL_MAKEFILE := $(abspath $(lastword $(MAKEFILE_LIST)))
REPO_ROOT ?= $(patsubst %/,%,$(abspath $(dir $(LOCAL_MAKEFILE))/../..))
REPO_NAME ?= $(notdir $(REPO_ROOT))
SHELL := /bin/bash
V ?= 0
ifeq ($(V),1)
Q :=
else
Q := @
endif
WITH_REPO_LOCK := "$(REPO_ROOT)/scripts/with_repo_lock.sh"
LOCKED_MAKE = $(if $(filter 1,$(EDK2_CIX_REPO_LOCK_HELD)),$(MAKE) --no-print-directory,$(WITH_REPO_LOCK) $(MAKE) --no-print-directory)
MAKE_INPUT_VALIDATOR := $(REPO_ROOT)/scripts/validate_make_inputs.py
VALIDATION_PROFILE_FILE := $(REPO_ROOT)/validation/expected-hashes.json
MAX_DEBUG_PRINT_ERROR_LEVEL := $(shell python3 "$(MAKE_INPUT_VALIDATOR)" max-debug-print-error-level 2>/dev/null || printf '%s' 0x807B55FF)
BUILDBOX_WORKSPACE_PARENT ?= /workspaces
BUILDBOX_WORKSPACE_ROOT ?= $(BUILDBOX_WORKSPACE_PARENT)/$(PROJECT)
BUILDBOX_HOST_TMPDIR ?= $(REPO_ROOT)/.buildbox/tmp
BUILDBOX_CONTAINER_TMPDIR ?= /hosttmp
FIRMWARE_DISTRO ?= bookworm
BUILDBOX_IMAGE ?=
BUILDBOX_PLATFORM ?=
BUILDBOX_IMAGE_DEFAULT := mcr.microsoft.com/devcontainers/base:$(FIRMWARE_DISTRO)
BUILDBOX_IMAGE_EFFECTIVE := $(if $(strip $(BUILDBOX_IMAGE)),$(BUILDBOX_IMAGE),$(BUILDBOX_IMAGE_DEFAULT))
BUILDBOX_DEB_RESULT_ROOT ?= $(DEB_RESULT_ROOT)
BUILDBOX_DEB_RESULT_ROOT_IN_CONTAINER ?= $(BUILDBOX_WORKSPACE_ROOT)/dist/deb
BUILD_LOG_ROOT ?= $(REPO_ROOT)/build-logs
BUILDBOX_ENV = \
	EDK2_CIX_WORKSPACE_ROOT="$(BUILDBOX_WORKSPACE_ROOT)" \
	EDK2_CIX_HOST_TMPDIR="$(BUILDBOX_HOST_TMPDIR)" \
	EDK2_CIX_CONTAINER_TMPDIR="$(BUILDBOX_CONTAINER_TMPDIR)" \
	EDK2_CIX_VERBOSE="$(V)" \
	EDK2_CIX_BUILDBOX_IMAGE="$(BUILDBOX_IMAGE_EFFECTIVE)" \
	EDK2_CIX_BUILDBOX_PLATFORM="$(BUILDBOX_PLATFORM)"

PROJECT ?= edk2-cix
ARTEFACT_MODE ?= custom
DEBUG_ON_UART3 ?=
UART3_ENABLE ?=
DEBUG_VERBOSE ?=
DEBUG_PRINT_ERROR_LEVEL ?=
FIRMWARE_BOARD ?= O6
FIRMWARE_PRODUCT ?= orion-o6
DEFAULT_FIRMWARE_TARGET := RELEASE
FIRMWARE_TARGET ?= $(DEFAULT_FIRMWARE_TARGET)
RAW_FIRMWARE_TARGET := $(FIRMWARE_TARGET)_GCC5
FIRMWARE_VERSION ?= $(shell cd "$(REPO_ROOT)" && (dpkg-parsechangelog -S Version 2>/dev/null || sed -n '1s/^[^(]*(\([^)]*\)).*/\1/p' debian/changelog))
FIRMWARE_STAGE_ROOT ?= $(REPO_ROOT)/dist/firmware/$(FIRMWARE_PRODUCT)/$(FIRMWARE_VERSION)
FIRMWARE_INSTALL_ROOT ?= /boot/efi/firmware/radxa
FIRMWARE_ARCHIVE_ROOT ?= $(REPO_ROOT)/dist
FIRMWARE_ARCHIVE_BASENAME ?= edk2-cix-$(FIRMWARE_PRODUCT)-$(FIRMWARE_VERSION)
FIRMWARE_VALIDATION_PROFILE ?= upstream-1.2.1-bookworm
FIRMWARE_VALIDATION_REPORT_ROOT ?= $(REPO_ROOT)/build-validation
MONOREPO_META_ROOT ?=
FIRMWARE_VALIDATE_ON_BUILD ?= 0
DEBUG_ON_UART3_NORMALIZED_RAW := $(if $(strip $(DEBUG_ON_UART3)),$(shell python3 "$(MAKE_INPUT_VALIDATOR)" normalize-bool --value "$(DEBUG_ON_UART3)" 2>/dev/null || printf '%s' __INVALID__),)
DEBUG_ON_UART3_NORMALIZED := $(if $(filter __INVALID__,$(DEBUG_ON_UART3_NORMALIZED_RAW)),,$(DEBUG_ON_UART3_NORMALIZED_RAW))
UART3_ENABLE_NORMALIZED_RAW := $(if $(strip $(UART3_ENABLE)),$(shell python3 "$(MAKE_INPUT_VALIDATOR)" normalize-bool --value "$(UART3_ENABLE)" 2>/dev/null || printf '%s' __INVALID__),)
UART3_ENABLE_NORMALIZED := $(if $(filter __INVALID__,$(UART3_ENABLE_NORMALIZED_RAW)),,$(UART3_ENABLE_NORMALIZED_RAW))
UART3_ENABLE_EFFECTIVE := $(if $(filter TRUE,$(DEBUG_ON_UART3_NORMALIZED)),TRUE,$(UART3_ENABLE_NORMALIZED))
DEBUG_VERBOSE_NORMALIZED_RAW := $(if $(strip $(DEBUG_VERBOSE)),$(shell python3 "$(MAKE_INPUT_VALIDATOR)" normalize-bool --value "$(DEBUG_VERBOSE)" 2>/dev/null || printf '%s' __INVALID__),)
DEBUG_VERBOSE_NORMALIZED := $(if $(filter __INVALID__,$(DEBUG_VERBOSE_NORMALIZED_RAW)),,$(DEBUG_VERBOSE_NORMALIZED_RAW))
DEBUG_PRINT_ERROR_LEVEL_NORMALIZED_RAW := $(if $(strip $(DEBUG_PRINT_ERROR_LEVEL)),$(shell python3 "$(MAKE_INPUT_VALIDATOR)" normalize-u32 --value "$(DEBUG_PRINT_ERROR_LEVEL)" 2>/dev/null || printf '%s' __INVALID__),)
DEBUG_PRINT_ERROR_LEVEL_NORMALIZED := $(if $(filter __INVALID__,$(DEBUG_PRINT_ERROR_LEVEL_NORMALIZED_RAW)),,$(DEBUG_PRINT_ERROR_LEVEL_NORMALIZED_RAW))
DEBUG_PRINT_ERROR_LEVEL_VERBOSE_DEFAULT := $(if $(filter TRUE,$(DEBUG_VERBOSE_NORMALIZED)),$(MAX_DEBUG_PRINT_ERROR_LEVEL),)
DEBUG_PRINT_ERROR_LEVEL_EFFECTIVE := $(if $(strip $(DEBUG_PRINT_ERROR_LEVEL_NORMALIZED)),$(DEBUG_PRINT_ERROR_LEVEL_NORMALIZED),$(DEBUG_PRINT_ERROR_LEVEL_VERBOSE_DEFAULT))
FIRMWARE_VALIDATE_ON_BUILD_NORMALIZED_RAW := $(if $(strip $(FIRMWARE_VALIDATE_ON_BUILD)),$(shell python3 "$(MAKE_INPUT_VALIDATOR)" normalize-bool --value "$(FIRMWARE_VALIDATE_ON_BUILD)" 2>/dev/null || printf '%s' __INVALID__),)
FIRMWARE_VALIDATE_ON_BUILD_NORMALIZED := $(if $(filter __INVALID__,$(FIRMWARE_VALIDATE_ON_BUILD_NORMALIZED_RAW)),,$(FIRMWARE_VALIDATE_ON_BUILD_NORMALIZED_RAW))
FIRMWARE_VALIDATE_ON_BUILD_EFFECTIVE := $(if $(filter TRUE,$(FIRMWARE_VALIDATE_ON_BUILD_NORMALIZED)),1,0)
FIRMWARE_BOARD_LOWER = $(shell printf '%s' '$(FIRMWARE_BOARD)' | tr '[:upper:]' '[:lower:]')
REPLAY_VERSION ?= $(FIRMWARE_VERSION)
REPLAY_PRODUCT ?= orion-$(FIRMWARE_BOARD_LOWER)
DETERMINISTIC_REPLAY_PROFILE ?= upstream-$(REPLAY_VERSION)-$(FIRMWARE_DISTRO)
DETERMINISTIC_REPLAY_CACHE_KEY ?= $(DETERMINISTIC_REPLAY_PROFILE)-$(FIRMWARE_BOARD_LOWER)
DETERMINISTIC_REPLAY_ROOT ?= $(REPO_ROOT)/.buildbox/replay/$(DETERMINISTIC_REPLAY_CACHE_KEY)
DETERMINISTIC_REPLAY_IMAGE ?= $(BUILDBOX_IMAGE_EFFECTIVE)
DETERMINISTIC_REPLAY_MOUNT_ROOT ?= $(REPO_ROOT)/.buildbox
REPLAY_INPUT ?=
REPLAY_BUILD_OPTIONS ?=
REPLAY_BUILD_DATE ?=
ACT_WORKFLOW ?=
ACT_EVENT ?= workflow_dispatch
ACT_JOB ?=
ACT_MATRIX ?=
ACT_SECRET_FILE ?=
ACT_EXTRA_ARGS ?=
ACT_CLEAN_KEEP ?=
SRC_COMMON_ARGS = \
	ARTEFACT_MODE="$(ARTEFACT_MODE)" \
	$(if $(strip $(DEBUG_ON_UART3_NORMALIZED)),DEBUG_ON_UART3="$(DEBUG_ON_UART3_NORMALIZED)") \
	$(if $(strip $(UART3_ENABLE_EFFECTIVE)),UART3_ENABLE="$(UART3_ENABLE_EFFECTIVE)") \
	$(if $(strip $(DEBUG_VERBOSE_NORMALIZED)),DEBUG_VERBOSE="$(DEBUG_VERBOSE_NORMALIZED)") \
	$(if $(strip $(DEBUG_PRINT_ERROR_LEVEL_EFFECTIVE)),DEBUG_PRINT_ERROR_LEVEL="$(DEBUG_PRINT_ERROR_LEVEL_EFFECTIVE)")
FIRMWARE_SRC_BUILD_TARGETS = \
	Build/$(FIRMWARE_BOARD)/$(RAW_FIRMWARE_TARGET)/cix_flash_all.bin \
	Build/$(FIRMWARE_BOARD)/$(RAW_FIRMWARE_TARGET)/cix_flash_ota.bin
BUILDBOX_FIRMWARE_ARGS = \
	$(SRC_COMMON_ARGS) \
	FIRMWARE_BOARD="$(FIRMWARE_BOARD)" \
	FIRMWARE_PRODUCT="$(FIRMWARE_PRODUCT)" \
	FIRMWARE_TARGET="$(FIRMWARE_TARGET)" \
	FIRMWARE_VERSION="$(FIRMWARE_VERSION)" \
	FIRMWARE_VALIDATE_ON_BUILD="$(FIRMWARE_VALIDATE_ON_BUILD_EFFECTIVE)" \
	FIRMWARE_STAGE_ROOT="$(BUILDBOX_WORKSPACE_ROOT)/dist/firmware/$(FIRMWARE_PRODUCT)/$(FIRMWARE_VERSION)" \
	FIRMWARE_ARCHIVE_ROOT="$(BUILDBOX_WORKSPACE_ROOT)/dist" \
	FIRMWARE_VALIDATION_PROFILE="$(FIRMWARE_VALIDATION_PROFILE)" \
	FIRMWARE_VALIDATION_REPORT_ROOT="$(BUILDBOX_WORKSPACE_ROOT)/build-validation" \
	$(if $(strip $(BUILD_DATE)),BUILD_DATE="$(BUILD_DATE)") \
	$(if $(strip $(SOURCE_DATE_EPOCH)),SOURCE_DATE_EPOCH="$(SOURCE_DATE_EPOCH)") \
	$(if $(strip $(PM_CONFIG_SOURCE_DATE_EPOCH)),PM_CONFIG_SOURCE_DATE_EPOCH="$(PM_CONFIG_SOURCE_DATE_EPOCH)") \
	$(if $(strip $(SOURCE_COMMIT)),SOURCE_COMMIT="$(SOURCE_COMMIT)") \
	$(if $(strip $(SOURCE_COMMIT_HASH)),SOURCE_COMMIT_HASH="$(SOURCE_COMMIT_HASH)") \
	$(if $(strip $(EDK2_COMMIT_HASH)),EDK2_COMMIT_HASH="$(EDK2_COMMIT_HASH)") \
	$(if $(strip $(EDK2_NON_OSI_COMMIT_HASH)),EDK2_NON_OSI_COMMIT_HASH="$(EDK2_NON_OSI_COMMIT_HASH)") \
	$(if $(strip $(EDK2_PLATFORMS_COMMIT_HASH)),EDK2_PLATFORMS_COMMIT_HASH="$(EDK2_PLATFORMS_COMMIT_HASH)") \
	$(if $(strip $(DEB_VERSION)),DEB_VERSION="$(DEB_VERSION)")

src/tools/gcc/gcc-arm-10.2-2020.11-x86_64-aarch64-none-elf.tar.xz:
	$(Q)mkdir -p src/tools/gcc
	$(Q)wget -O $@ \
	"https://developer.arm.com/-/media/files/downloads/gnu-a/10.2-2020.11/binrel/gcc-arm-10.2-2020.11-x86_64-aarch64-none-elf.tar.xz"

src/tools/gcc/%: src/tools/gcc/%.tar.xz
	$(Q)tar xvf $< -C src/tools/gcc/

build: build-edk2

define PRINT_HELP_SHELL_PROLOGUE
	set -eu; \
	help_pad=31; \
	help_gap=2; \
	help_width=80; \
	desc_width=$$((help_width - help_pad - help_gap)); \
	desc_indent=$$(printf '%*s' "$$((help_pad + help_gap))" ''); \
	print_help_line() { \
		label="$$1"; \
		desc="$$2"; \
		if [ "$${#label}" -le "$$help_pad" ]; then \
			first_indent=$$(printf '%-*s%*s' "$$help_pad" "$$label" "$$help_gap" ''); \
			printf '%b\n' "$$desc" | fold -s -w "$$desc_width" | \
				awk -v first="$$first_indent" -v cont="$$desc_indent" \
					'NR == 1 { print first $$0; next } { sub(/^ +/, "", $$0); print cont $$0 }'; \
		else \
			printf '%s\n' "$$label"; \
			printf '%b\n' "$$desc" | fold -s -w "$$desc_width" | \
				awk -v cont="$$desc_indent" \
					'{ sub(/^ +/, "", $$0); print cont $$0 }'; \
		fi; \
	}; \
	print_section() { \
		printf '\n%s\n\n' "$$1"; \
	}
endef

define PRINT_TOP_LEVEL_USER_VARIABLES
	print_help_line '  ARTEFACT_MODE=custom|upstream' 'Generate unmodified upstream firmware images or allow custom enhancements.\nDefault: custom.'; \
	print_help_line '  FIRMWARE_BOARD=O6|O6N' 'Select the firmware board; replay follows the same board.\nDefault: O6.'; \
	print_help_line '  FIRMWARE_TARGET=RELEASE|DEBUG' 'Select RELEASE or DEBUG firmware build.\nDefault: RELEASE.'; \
	print_help_line '  UART3_ENABLE=true|false' 'Custom-only: expose UART3 to ACPI and mux its header pins as UART instead of GPIO.\nDefault: false.'; \
	print_help_line '  DEBUG_ON_UART3=true|false' 'Custom-only: route firmware DEBUG() output to UART3; implies UART3_ENABLE=true.\nDefault: unset; custom builds keep DEBUG() on UART2.'; \
	print_help_line '  DEBUG_VERBOSE=true|false' 'Custom-only: on RELEASE builds, re-enable DEBUG() logging with minimal runtime side effects and default to the full DEBUG_* mask unless DEBUG_PRINT_ERROR_LEVEL is set.\nDefault: false.'; \
	print_help_line '  DEBUG_PRINT_ERROR_LEVEL=<u32>' 'Custom-only: override the firmware debug message mask with a decimal or 0x-prefixed 32-bit value.\nDefault: unset; builds use 0x80000040 by default or $(MAX_DEBUG_PRINT_ERROR_LEVEL) when DEBUG_VERBOSE=true.\nSee '\''make help-debug'\'''
endef

define PRINT_TOP_LEVEL_DEV_VARIABLES
	print_help_line '  V=0|1' 'Set V=1 to show raw EDK2 command lines.\nDefault: 0.'; \
	print_help_line '  FIRMWARE_VALIDATE_ON_BUILD=0|1' 'Enable or skip automatic output validation after firmware-build.\nDefault: 0; enable explicitly for qualification or diagnostic runs.'; \
	print_help_line '  FIRMWARE_VALIDATION_PROFILE=<name>' 'Validation profile from validation/expected-hashes.json, e.g. '\''upstream-1.2.1-bookworm'\'' or '\''upstream-1.2.1-trixie'\''\nDefault: '\''upstream-1.2.1-bookworm'\'''; \
	print_help_line '  FIRMWARE_VALIDATION_REPORT_ROOT=<path>' 'Directory for validation and audit JSON reports.\nDefault: '\''$$(REPO_ROOT)/build-validation'\'''; \
	print_help_line '  MONOREPO_META_ROOT=<path>' 'Optional main-monorepo-meta checkout used by audit-bundle for the metadata-consistency check.\nDefault: unset.'; \
	print_help_line '  FIRMWARE_DISTRO=bookworm|trixie' 'Select the default distro family for buildbox runs and deterministic replay.\nDefault: bookworm.'; \
	print_help_line '  BUILDBOX_PLATFORM=linux/amd64|linux/arm64' 'Select the container platform for buildbox runs.\nDefault: host-matched runtime platform.'; \
	print_help_line '  BUILDBOX_IMAGE=<image>' 'Override the selected buildbox container image directly.\nDefault: '\''mcr.microsoft.com/devcontainers/base:$(FIRMWARE_DISTRO)'\'''; \
	print_help_line '  REPLAY_INPUT=<path>' 'Seed replay inputs from a .deb, an extracted release dir, or cix_flash_all.bin.\nDefault: unset; reuse cached replay inputs if present.'; \
	print_help_line '  REPLAY_BUILD_OPTIONS=<path>' 'BuildOptions file used when replaying from cix_flash_all.bin.\nDefault: unset.'; \
	print_help_line '  REPLAY_BUILD_DATE=<iso8601>' 'Fallback build timestamp when replay inputs do not include BuildOptions.\nDefault: unset.'; \
	print_help_line '  ACT_WORKFLOW=.github/workflows/<file>.yaml' 'Workflow file to list, dry-run, or execute through the local act wrapper.\nDefault: unset; gha-act-list shows every workflow when this stays empty.'; \
	print_help_line '  ACT_EVENT=workflow_dispatch|push|pull_request' 'Event name passed to act for gha-act-dry-run and gha-act-run.\nDefault: '\''workflow_dispatch'\'''; \
	print_help_line '  ACT_JOB=<job-id>' 'Optional job to target inside the selected workflow.\nDefault: unset.'; \
	print_help_line '  ACT_MATRIX=<name:value>' 'Optional single act matrix filter, for example '\''board:O6'\''\nDefault: unset.'; \
	print_help_line '  ACT_SECRET_FILE=<path>' 'Optional act --secret-file path for local workflow runs.\nDefault: unset.'; \
	print_help_line '  ACT_EXTRA_ARGS=<args>' 'Additional raw flags appended to act, for example '\''--pull=false'\''\nDefault: unset.'; \
	print_help_line '  ACT_CLEAN_KEEP=0|1' 'Preserve the temporary clean checkout used by gha-act-run-clean for debugging.\nDefault: unset.'
endef

define PRINT_TOP_LEVEL_INTERNAL_VARIABLES
	print_help_line '  BUILDBOX_WORKSPACE_PARENT=<path>' 'Override the parent path used for the in-container workspace mount.\nDefault: '\''/workspaces'\'''; \
	print_help_line '  BUILDBOX_WORKSPACE_ROOT=<path>' 'Override the exact in-container workspace path used by buildbox wrappers.\nDefault: '\''$$(BUILDBOX_WORKSPACE_PARENT)/$$(PROJECT)'\''' ; \
	print_help_line '  BUILDBOX_HOST_TMPDIR=<path>' 'Host temporary directory mounted into buildbox runs.\nDefault: '\''$$(REPO_ROOT)/.buildbox/tmp'\'''; \
	print_help_line '  BUILDBOX_CONTAINER_TMPDIR=<path>' 'In-container path corresponding to BUILDBOX_HOST_TMPDIR.\nDefault: '\''/hosttmp'\'''; \
	print_help_line '  EDK2_CIX_CONTAINER_RUNTIME=<runtime>' 'Force a specific container runtime, usually '\''docker'\'' or '\''podman'\'''; \
	print_help_line '  EDK2_CIX_BUILDBOX_NAME=<name>' 'Pin the buildbox container name instead of using the stored per-worktree default.'; \
	print_help_line '  EDK2_CIX_BUILDBOX_NAME_FILE=<path>' 'Alternate path for the persisted buildbox container-name file.'; \
	print_help_line '  DETERMINISTIC_REPLAY_PROFILE=<name>' 'Override the resolved replay validation profile name.\nDefault: upstream-<version>-<distro>.'; \
	print_help_line '  DETERMINISTIC_REPLAY_CACHE_KEY=<name>' 'Override the replay cache directory key.\nDefault: $(DETERMINISTIC_REPLAY_PROFILE)-<board>.'; \
	print_help_line '  DETERMINISTIC_REPLAY_ROOT=<path>' 'Exact replay cache directory used by deterministic-replay.\nDefault: '\''$$(REPO_ROOT)/.buildbox/replay/<cache-key>'\'''; \
	print_help_line '  DETERMINISTIC_REPLAY_IMAGE=<image>' 'Container image override used only by deterministic-replay.\nDefault: the effective buildbox image.'; \
	print_help_line '  DETERMINISTIC_REPLAY_MOUNT_ROOT=<path>' 'Host root that deterministic-replay may translate into the buildbox.\nDefault: '\''$$(REPO_ROOT)/.buildbox'\'''; \
	print_help_line '  EDK2_CIX_SUPPRESS_FINAL_OUTPUT=0|1' 'Suppress the final top-level wrapper status lines.'; \
	print_help_line '  EDK2_CIX_SUPPRESS_EXPORT_OUTPUT=0|1' 'Suppress export_firmware_payload.py status lines during wrapper chaining.'; \
	print_help_line '  EDK2_CIX_ACT_CLEAN_KEEP=0|1' 'Internal handoff used by gha-act-run-clean to preserve the scratch checkout.'; \
	print_help_line '  EDK2_CIX_REPO_LOCK_HELD=0|1' 'Internal recursion guard for the repo-lock wrapper.'
endef

.PHONY: help help-vars help-dev help-internal help-debug
help:
	@$(PRINT_HELP_SHELL_PROLOGUE); \
	printf '%s\n\n' 'edk2-cix common targets'; \
	print_help_line '  firmware_build_dep' 'Install only the direct firmware-build host dependencies'; \
	print_help_line '  devcontainer_setup' 'Install host build dependencies'; \
	print_help_line '  firmware-build' 'Build the O6 firmware artefacts'; \
	print_help_line '  firmware-stage' 'Stage deployable firmware files under dist/firmware/'; \
	print_help_line '  install' 'Copy the staged payload under /boot/efi/firmware/radxa/'; \
	print_help_line '  zip' 'Create a .zip firmware archive'; \
	print_help_line '  targz' 'Create a .tar.gz firmware archive'; \
	print_help_line '  deb' 'Build the Debian package and copy it under dist/deb/'; \
	print_help_line '  clean' 'Remove build output, packaging by-products, and buildbox state'; \
	printf '\n%s\n\n' 'buildbox targets'; \
	print_help_line '  buildbox-firmware-build' 'Build firmware inside the buildbox'; \
	print_help_line '  buildbox-firmware-stage' 'Stage deployable firmware on the host under dist/firmware/'; \
	print_help_line '  buildbox-zip' 'Create a .zip archive inside the buildbox'; \
	print_help_line '  buildbox-targz' 'Create a .tar.gz archive inside the buildbox'; \
	print_help_line '  buildbox-deb' 'Build the Debian package inside the buildbox under dist/deb/'; \
	printf '\n%s\n\n' 'more help'; \
	print_help_line '  help-vars' 'Show accepted top-level control variables'; \
	print_help_line '  help-dev' 'Show maintainer and developer targets plus advanced control variables'; \
	print_help_line '  help-internal' 'Show internal wrapper targets and unstable implementation knobs'; \
	printf '\n%s\n' 'For lower-level firmware targets, run: make -C src help'

help-vars:
	@$(PRINT_HELP_SHELL_PROLOGUE); \
	printf '%s\n\n' 'common build variables'; \
	$(PRINT_TOP_LEVEL_USER_VARIABLES); \
	printf '\n%s\n' 'For maintainer and developer targets plus advanced variables, run: make help-dev'; \
	printf '%s\n' 'For internal wrapper targets and unstable implementation knobs, run: make help-internal'

help-dev:
	@$(PRINT_HELP_SHELL_PROLOGUE); \
	printf '%s\n\n' 'maintainer and developer targets'; \
	print_help_line '  arm64_crossbuild_dep' 'Install Debian arm64 cross-build dependencies'; \
	print_help_line '  build-edk2' 'Run the raw src/ firmware build directly'; \
	print_help_line '  validate-firmware' 'Check outputs against the active validation profile'; \
	print_help_line '  validate-firmware-strict' 'Require exact matches from the validation profile'; \
	print_help_line '  check-offline-audit-baselines' 'Validate the checked-in offline audit baseline JSON structure'; \
	print_help_line '  audit-final-image-manifest' 'Check final BL33 firmware composition against the stored baseline'; \
	print_help_line '  audit-acpi-regression' 'Check final ACPI tables and IASL diagnostics against the stored baseline'; \
	print_help_line '  refresh-offline-audit-baselines' 'Refresh both offline audit baseline files from the selected board build'; \
	print_help_line '  audit-bundle' 'Run the maintainer-focused structural audit bundle for the selected board'; \
	print_help_line '  capture-validation-profile' 'Snapshot the current build into a profile JSON'; \
	print_help_line '  deterministic-replay' 'Seed or reuse exact replay inputs, rebuild, and validate them strictly'; \
	print_help_line '  buildbox-up' 'Start or reuse the persistent build container'; \
	print_help_line '  buildbox-metadata' 'Print resolved build metadata inside the buildbox'; \
	print_help_line '  buildbox-o6-log' 'Capture a full logged buildbox firmware build'; \
	print_help_line '  buildbox-validate-firmware' 'Run validation inside the buildbox'; \
	print_help_line '  buildbox-validate-firmware-strict' 'Run strict validation inside the buildbox'; \
	print_help_line '  buildbox-audit-final-image-manifest' 'Run the final-image manifest audit inside the buildbox'; \
	print_help_line '  buildbox-audit-acpi-regression' 'Run the ACPI regression audit inside the buildbox'; \
	print_help_line '  buildbox-audit-bundle' 'Run the full maintainer audit bundle inside the buildbox'; \
	print_help_line '  buildbox-validate-secure-boot-defaults' 'Validate embedded Secure Boot payloads inside the buildbox'; \
	print_help_line '  buildbox-capture-validation-profile' 'Capture a validation profile inside the buildbox'; \
	print_help_line '  buildbox-down' 'Remove the persistent build container if it exists'; \
	print_help_line '  gha-act-list' 'List workflows and jobs through the repo-local act wrapper'; \
	print_help_line '  gha-act-dry-run' 'Dry-run a selected workflow or job through act'; \
	print_help_line '  gha-act-run' 'Execute a selected workflow or job through act'; \
	print_help_line '  gha-act-run-clean' 'Execute a selected workflow or job through act from a scratch checkout'; \
	print_help_line '  docs-build' 'Build the mdBook site into book/html/'; \
	print_help_line '  serve' 'Serve the mdBook site locally with mdbook serve'; \
	print_help_line '  dch' 'Generate and commit a Debian changelog release entry'; \
	print_help_line '  release' 'Trigger the retained GitHub release workflow for the current branch'; \
	print_help_line '  help-debug' 'Explain the DEBUG_PRINT_ERROR_LEVEL bit values derived from DebugLib.h'; \
	print_section 'maintainer and developer variables'; \
	$(PRINT_TOP_LEVEL_DEV_VARIABLES); \
	printf '\n%s\n' 'For regular firmware build usage, run: make help'; \
	printf '%s\n' 'For internal wrapper targets and unstable implementation knobs, run: make help-internal'

help-internal:
	@$(PRINT_HELP_SHELL_PROLOGUE); \
	printf '%s\n\n' 'internal wrapper targets'; \
	print_help_line '  preflight-wrapper-common' 'Shared top-level input validation used by most public wrapper targets.'; \
	print_help_line '  preflight-wrapper-firmware-build' 'Additional validation for public firmware build and staging wrappers.'; \
	print_help_line '  preflight-wrapper-validation' 'Additional validation for public validation and profile-capture wrappers.'; \
	print_help_line '  preflight-wrapper-buildbox' 'Additional validation for buildbox lifecycle and image selection wrappers.'; \
	print_help_line '  preflight-wrapper-replay' 'Additional validation for deterministic-replay cache and seed inputs.'; \
	print_help_line '  clean-edk2' 'Remove only src/Build output and generated raw firmware artefacts.'; \
	print_help_line '  clean-buildbox' 'Remove only the local buildbox state and persistent container.'; \
	print_section 'internal variables'; \
	$(PRINT_TOP_LEVEL_INTERNAL_VARIABLES); \
	printf '\n%s\n' 'Internal targets and variables are unstable and may change without compatibility guarantees.'; \
	printf '%s\n' 'For regular usage, run: make help'

help-debug:
	@$(PRINT_HELP_SHELL_PROLOGUE); \
	printf '%s\n\n' 'debug print levels'; \
	printf '%s\n' 'Custom-only: set DEBUG_PRINT_ERROR_LEVEL to a decimal or '\
'0x-prefixed 32-bit value to choose which DEBUG() message classes are '\
'printed. Combine entries by ORing or summing their values. Default: '\
'0x80000040 (DEBUG_INFO|DEBUG_ERROR). If DEBUG_VERBOSE=true and you do '\
'not set DEBUG_PRINT_ERROR_LEVEL explicitly, the build uses 0x807B55FF, '\
'which enables all available DEBUG_* message levels by default.' | fold -s -w 78 | sed 's/^/  /'; \
	printf '\n'; \
	python3 "$(MAKE_INPUT_VALIDATOR)" list-debug-print-error-level-bits | \
	awk '{ mask=$$1; name=$$2; $$1=""; $$2=""; sub(/^ +/, "", $$0); printf "%s\t%s\t%s\n", mask, name, $$0 }' | \
	while IFS=$$(printf '\t') read -r mask name desc; do \
		print_help_line "  $$mask $$name" "$$desc"; \
	done

.PHONY: preflight-wrapper-common preflight-wrapper-firmware-build preflight-wrapper-validation preflight-wrapper-buildbox preflight-wrapper-replay
preflight-wrapper-common:
	@set -euo pipefail; \
	validate_cmd=(python3 "$(MAKE_INPUT_VALIDATOR)" validate \
		--repo-root "$(REPO_ROOT)" \
		--profile-file "$(VALIDATION_PROFILE_FILE)" \
		--v "$(V)" \
		--artefact-mode "$(ARTEFACT_MODE)"); \
	if [ -n "$(strip $(FIRMWARE_TARGET))" ]; then \
		validate_cmd+=(--firmware-target "$(strip $(FIRMWARE_TARGET))"); \
	fi; \
	if [ -n "$(strip $(DEBUG_ON_UART3))" ]; then \
		validate_cmd+=(--debug-on-uart3 "$(strip $(DEBUG_ON_UART3))"); \
	fi; \
	if [ -n "$(strip $(UART3_ENABLE_EFFECTIVE))" ]; then \
		validate_cmd+=(--uart3-enable "$(strip $(UART3_ENABLE_EFFECTIVE))"); \
	fi; \
	if [ -n "$(strip $(DEBUG_VERBOSE_NORMALIZED))" ]; then \
		validate_cmd+=(--debug-verbose "$(strip $(DEBUG_VERBOSE_NORMALIZED))"); \
	fi; \
	if [ -n "$(strip $(DEBUG_PRINT_ERROR_LEVEL_EFFECTIVE))" ]; then \
		validate_cmd+=(--debug-print-error-level "$(strip $(DEBUG_PRINT_ERROR_LEVEL_EFFECTIVE))"); \
	fi; \
	"$${validate_cmd[@]}"

preflight-wrapper-firmware-build: preflight-wrapper-common
	@set -euo pipefail; \
	validate_cmd=(python3 "$(MAKE_INPUT_VALIDATOR)" validate \
		--repo-root "$(REPO_ROOT)" \
		--profile-file "$(VALIDATION_PROFILE_FILE)" \
		--v "$(V)" \
		--artefact-mode "$(ARTEFACT_MODE)" \
		--firmware-target "$(FIRMWARE_TARGET)" \
		--firmware-board "$(FIRMWARE_BOARD)" \
		--firmware-validate-on-build "$(FIRMWARE_VALIDATE_ON_BUILD)"); \
	if [ -n "$(strip $(FIRMWARE_VALIDATION_PROFILE))" ] && [ "$(FIRMWARE_VALIDATE_ON_BUILD_EFFECTIVE)" = "1" ]; then \
		validate_cmd+=(--validation-profile "$(FIRMWARE_VALIDATION_PROFILE)" --validation-board "$(FIRMWARE_BOARD)" --validation-target "$(RAW_FIRMWARE_TARGET)"); \
	fi; \
	"$${validate_cmd[@]}"

preflight-wrapper-validation: preflight-wrapper-common
	@set -euo pipefail; \
	validate_cmd=(python3 "$(MAKE_INPUT_VALIDATOR)" validate \
		--repo-root "$(REPO_ROOT)" \
		--profile-file "$(VALIDATION_PROFILE_FILE)" \
		--v "$(V)" \
		--artefact-mode "$(ARTEFACT_MODE)" \
		--firmware-target "$(FIRMWARE_TARGET)" \
		--firmware-board "$(FIRMWARE_BOARD)" \
		--firmware-validate-on-build "$(FIRMWARE_VALIDATE_ON_BUILD)" \
		--validation-profile "$(FIRMWARE_VALIDATION_PROFILE)" \
		--validation-board "$(FIRMWARE_BOARD)" \
		--validation-target "$(RAW_FIRMWARE_TARGET)"); \
	"$${validate_cmd[@]}"

preflight-wrapper-buildbox:
	@set -euo pipefail; \
	validate_cmd=(python3 "$(MAKE_INPUT_VALIDATOR)" validate \
		--repo-root "$(REPO_ROOT)" \
		--profile-file "$(VALIDATION_PROFILE_FILE)" \
		--v "$(V)"); \
	if [ -n "$(strip $(FIRMWARE_DISTRO))" ]; then \
		validate_cmd+=(--firmware-distro "$(strip $(FIRMWARE_DISTRO))"); \
	fi; \
	if [ -n "$(strip $(BUILDBOX_PLATFORM))" ]; then \
		validate_cmd+=(--buildbox-platform "$(strip $(BUILDBOX_PLATFORM))"); \
	fi; \
	if [ -n "$(strip $(BUILDBOX_IMAGE))" ]; then \
		validate_cmd+=(--buildbox-image "$(strip $(BUILDBOX_IMAGE))" --check-buildbox-image); \
	fi; \
	"$${validate_cmd[@]}"

preflight-wrapper-replay: preflight-wrapper-buildbox
	@set -euo pipefail; \
	validate_cmd=(python3 "$(MAKE_INPUT_VALIDATOR)" validate \
		--repo-root "$(REPO_ROOT)" \
		--profile-file "$(VALIDATION_PROFILE_FILE)" \
		--v "$(V)" \
		--firmware-target "$(FIRMWARE_TARGET)" \
		--firmware-board "$(FIRMWARE_BOARD)" \
		--validation-profile "$(DETERMINISTIC_REPLAY_PROFILE)" \
		--validation-board "$(FIRMWARE_BOARD)" \
		--validation-target "$(RAW_FIRMWARE_TARGET)"); \
	if [ -n "$(strip $(REPLAY_INPUT))" ]; then \
		validate_cmd+=(--replay-input "$(strip $(REPLAY_INPUT))"); \
	fi; \
	if [ -n "$(strip $(REPLAY_BUILD_OPTIONS))" ]; then \
		validate_cmd+=(--replay-build-options "$(strip $(REPLAY_BUILD_OPTIONS))"); \
	fi; \
	if [ -n "$(strip $(REPLAY_BUILD_DATE))" ]; then \
		validate_cmd+=(--replay-build-date "$(strip $(REPLAY_BUILD_DATE))"); \
	fi; \
	"$${validate_cmd[@]}"

.PHONY: build-edk2 firmware-build firmware-stage install zip targz validate-firmware validate-firmware-strict check-offline-audit-baselines audit-final-image-manifest audit-acpi-regression refresh-offline-audit-baselines audit-bundle capture-validation-profile deterministic-replay gha-act-list gha-act-dry-run gha-act-run gha-act-run-clean buildbox-up buildbox-deb buildbox-firmware-build buildbox-o6-log buildbox-firmware-stage buildbox-zip buildbox-targz buildbox-validate-firmware buildbox-validate-secure-boot-defaults buildbox-validate-firmware-strict buildbox-audit-final-image-manifest buildbox-audit-acpi-regression buildbox-audit-bundle buildbox-capture-validation-profile buildbox-metadata
build-edk2: preflight-wrapper-common
firmware-build firmware-stage install zip targz: preflight-wrapper-firmware-build
validate-firmware validate-firmware-strict refresh-offline-audit-baselines audit-final-image-manifest audit-acpi-regression audit-bundle capture-validation-profile: preflight-wrapper-validation
deterministic-replay: preflight-wrapper-replay
buildbox-up buildbox-deb: preflight-wrapper-buildbox
buildbox-metadata: preflight-wrapper-common preflight-wrapper-buildbox
