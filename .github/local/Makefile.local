__buildbox-firmware-stage:
	$(Q)$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" make --no-print-directory firmware-stage V="$(V)" EDK2_CIX_SUPPRESS_FINAL_OUTPUT=1 \
		$(BUILDBOX_FIRMWARE_ARGS)
