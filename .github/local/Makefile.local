.PHONY: clean __clean
clean:
	$(Q)$(LOCKED_MAKE) __clean V="$(V)"

__clean: __clean-edk2 __clean-buildbox

.PHONY: clean-edk2 __clean-edk2
clean-edk2:
	$(Q)$(LOCKED_MAKE) __clean-edk2 V="$(V)"

__clean-edk2:
	$(Q)$(MAKE) --no-print-directory -C "$(REPO_ROOT)/src" V="$(V)" clean

.PHONY: buildbox-down __buildbox-down
buildbox-down:
	$(Q)$(LOCKED_MAKE) __buildbox-down V="$(V)"

__buildbox-down:
	@buildbox_name_file="$(REPO_ROOT)/.buildbox/buildbox-name"; \
	container_names=(); \
	requested_runtime="$${EDK2_CIX_CONTAINER_RUNTIME:-}"; \
	default_runtime_helper="$(REPO_ROOT)/scripts/default_container_runtimes.sh"; \
	runtimes=(); \
	removed=0; \
	found_runtime=0; \
	add_runtime() { \
		local candidate="$$1"; \
		local existing; \
		[ -n "$$candidate" ] || return 0; \
		for existing in "$${runtimes[@]}"; do \
			if [ "$$existing" = "$$candidate" ]; then \
				return 0; \
			fi; \
		done; \
		runtimes+=("$$candidate"); \
	}; \
	add_container_name() { \
		local candidate="$$1"; \
		local existing; \
		[ -n "$$candidate" ] || return 0; \
		for existing in "$${container_names[@]}"; do \
			if [ "$$existing" = "$$candidate" ]; then \
				return 0; \
			fi; \
		done; \
		container_names+=("$$candidate"); \
	}; \
	if [ -n "$${EDK2_CIX_BUILDBOX_NAME:-}" ]; then \
		add_container_name "$${EDK2_CIX_BUILDBOX_NAME}"; \
	fi; \
	if [ -f "$$buildbox_name_file" ]; then \
		IFS= read -r stored_name <"$$buildbox_name_file" || true; \
		add_container_name "$$stored_name"; \
	fi; \
	add_container_name edk2-cix-buildbox; \
	if [ -n "$$requested_runtime" ]; then \
		add_runtime "$$requested_runtime"; \
	fi; \
	while IFS= read -r runtime; do \
		add_runtime "$$runtime"; \
	done < <(bash "$$default_runtime_helper"); \
	if [ "$${#runtimes[@]}" -eq 0 ]; then \
		add_runtime podman; \
		add_runtime docker; \
	fi; \
	for runtime in "$${runtimes[@]}"; do \
		command -v "$$runtime" >/dev/null 2>&1 || continue; \
		found_runtime=1; \
		for container_name in "$${container_names[@]}"; do \
			if "$$runtime" container inspect "$$container_name" >/dev/null 2>&1; then \
				printf '[clean] Removing buildbox container %s via %s\n' "$$container_name" "$$runtime"; \
				"$$runtime" rm -f "$$container_name" >/dev/null; \
				removed=1; \
			fi; \
		done; \
	done; \
	if [ "$$removed" -eq 0 ]; then \
		if [ "$$found_runtime" -eq 0 ]; then \
			printf '%s\n' '[clean] No container runtime available; skipping buildbox cleanup'; \
		else \
			printf '%s\n' '[clean] No buildbox container to remove'; \
		fi; \
	fi

.PHONY: clean-buildbox __clean-buildbox
clean-buildbox:
	$(Q)$(LOCKED_MAKE) __clean-buildbox V="$(V)"

__clean-buildbox: __buildbox-down
	@if [ -d "$(BUILDBOX_HOST_TMPDIR)" ]; then \
		printf '[clean] Removing buildbox scratch %s\n' "$(BUILDBOX_HOST_TMPDIR)"; \
		rm -rf "$(BUILDBOX_HOST_TMPDIR)"; \
	fi
	@if [ -f "$(REPO_ROOT)/.buildbox/buildbox-name" ]; then \
		printf '[clean] Removing buildbox name file %s\n' "$(REPO_ROOT)/.buildbox/buildbox-name"; \
		rm -f "$(REPO_ROOT)/.buildbox/buildbox-name"; \
	fi

.PHONY: buildbox-up __buildbox-up
buildbox-up:
	$(Q)$(LOCKED_MAKE) __buildbox-up V="$(V)"

__buildbox-up:
	$(Q)$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" true

.PHONY: buildbox-deb __buildbox-deb
buildbox-deb:
