LOCAL_MAKEFILE := $(abspath $(lastword $(MAKEFILE_LIST)))
REPO_ROOT ?= $(patsubst %/,%,$(abspath $(dir $(LOCAL_MAKEFILE))/../..))
REPO_NAME ?= $(notdir $(REPO_ROOT))
BUILDBOX_WORKSPACE_PARENT ?= /workspaces
BUILDBOX_WORKSPACE_ROOT ?= $(BUILDBOX_WORKSPACE_PARENT)/$(REPO_NAME)
BUILDBOX_HOST_TMPDIR ?= $(REPO_ROOT)/.buildbox/tmp
BUILDBOX_CONTAINER_TMPDIR ?= /hosttmp
BUILDBOX_IMAGE ?=
BUILDBOX_PLATFORM ?=
BUILDBOX_DEB_RESULT_ROOT ?= $(REPO_ROOT)/dist/deb
BUILDBOX_DEB_RESULT_ROOT_IN_CONTAINER ?= $(BUILDBOX_WORKSPACE_ROOT)/dist/deb
BUILD_LOG_ROOT ?= $(REPO_ROOT)/build-logs
BUILDBOX_ENV = \
	EDK2_CIX_WORKSPACE_ROOT="$(BUILDBOX_WORKSPACE_ROOT)" \
	EDK2_CIX_HOST_TMPDIR="$(BUILDBOX_HOST_TMPDIR)" \
	EDK2_CIX_CONTAINER_TMPDIR="$(BUILDBOX_CONTAINER_TMPDIR)" \
	EDK2_CIX_BUILDBOX_IMAGE="$(BUILDBOX_IMAGE)" \
	EDK2_CIX_BUILDBOX_PLATFORM="$(BUILDBOX_PLATFORM)"

PROJECT ?= edk2-cix
ARTEFACT_MODE ?= custom
FIRMWARE_BOARD ?= O6
FIRMWARE_PRODUCT ?= orion-o6
FIRMWARE_TARGET ?= RELEASE_GCC5
FIRMWARE_VERSION ?= $(shell cd "$(REPO_ROOT)" && (dpkg-parsechangelog -S Version 2>/dev/null || sed -n '1s/^[^(]*(\([^)]*\)).*/\1/p' debian/changelog))
FIRMWARE_STAGE_ROOT ?= $(REPO_ROOT)/dist/firmware/$(FIRMWARE_PRODUCT)/$(FIRMWARE_VERSION)
FIRMWARE_INSTALL_ROOT ?= /boot/efi/firmware/radxa
FIRMWARE_ARCHIVE_ROOT ?= $(REPO_ROOT)/dist
FIRMWARE_ARCHIVE_BASENAME ?= edk2-cix-$(FIRMWARE_PRODUCT)-$(FIRMWARE_VERSION)
FIRMWARE_VALIDATION_PROFILE ?= upstream-o6-1.2.1-bookworm
FIRMWARE_VALIDATION_REPORT_ROOT ?= $(REPO_ROOT)/build-validation
FIRMWARE_VALIDATE_ON_BUILD ?= $(if $(filter upstream,$(ARTEFACT_MODE)),1,0)
FIRMWARE_SRC_BUILD_TARGETS = \
	Build/$(FIRMWARE_BOARD)/$(FIRMWARE_TARGET)/cix_flash_all.bin \
	Build/$(FIRMWARE_BOARD)/$(FIRMWARE_TARGET)/cix_flash_ota.bin
BUILDBOX_FIRMWARE_ARGS = \
	ARTEFACT_MODE="$(ARTEFACT_MODE)" \
	FIRMWARE_BOARD="$(FIRMWARE_BOARD)" \
	FIRMWARE_PRODUCT="$(FIRMWARE_PRODUCT)" \
	FIRMWARE_TARGET="$(FIRMWARE_TARGET)" \
	FIRMWARE_VERSION="$(FIRMWARE_VERSION)" \
	FIRMWARE_STAGE_ROOT="$(BUILDBOX_WORKSPACE_ROOT)/dist/firmware/$(FIRMWARE_PRODUCT)/$(FIRMWARE_VERSION)" \
	FIRMWARE_ARCHIVE_ROOT="$(BUILDBOX_WORKSPACE_ROOT)/dist" \
	FIRMWARE_VALIDATION_PROFILE="$(FIRMWARE_VALIDATION_PROFILE)" \
	FIRMWARE_VALIDATION_REPORT_ROOT="$(BUILDBOX_WORKSPACE_ROOT)/build-validation"

src/tools/gcc/gcc-arm-10.2-2020.11-x86_64-aarch64-none-elf.tar.xz:
	mkdir -p src/tools/gcc
	wget -O $@ \
	"https://developer.arm.com/-/media/files/downloads/gnu-a/10.2-2020.11/binrel/gcc-arm-10.2-2020.11-x86_64-aarch64-none-elf.tar.xz"

src/tools/gcc/%: src/tools/gcc/%.tar.xz
	tar xvf $< -C src/tools/gcc/

build: build-edk2

.PHONY: help
help:
	@set -eu; \
	help_pad=40; \
	help_gap=2; \
	help_width=80; \
	desc_width=$$((help_width - help_pad - help_gap)); \
	print_help_line() { \
		label="$$1"; \
		desc="$$2"; \
		first_indent=$$(printf '%-*s%*s' "$$help_pad" "$$label" "$$help_gap" ''); \
		cont_indent=$$(printf '%*s' "$$((help_pad + help_gap))" ''); \
		printf '%s\n' "$$desc" | fold -s -w "$$desc_width" | \
			awk -v first="$$first_indent" -v cont="$$cont_indent" \
				'NR == 1 { print first $$0; next } { sub(/^ +/, "", $$0); print cont $$0 }'; \
	}; \
	printf '%s\n\n' 'edk2-cix common targets'; \
	print_help_line '  help' 'Show this help text'; \
	print_help_line '  firmware_build_dep' 'Install only the direct firmware-build host dependencies'; \
	print_help_line '  devcontainer_setup' 'Install host build dependencies'; \
	print_help_line '  build-edk2' 'Run the raw src/ firmware build'; \
	print_help_line '  firmware-build' 'Build the O6 firmware artefacts'; \
	print_help_line '  firmware-stage' 'Stage deployable firmware files under dist/firmware/'; \
	print_help_line '  install' 'Copy the staged payload under /boot/efi/firmware/radxa/'; \
	print_help_line '  zip' 'Create a .zip firmware archive'; \
	print_help_line '  targz' 'Create a .tar.gz firmware archive'; \
	print_help_line '  deb' 'Build the Debian package'; \
	print_help_line '  validate-firmware' 'Check outputs against the active validation profile'; \
	print_help_line '  validate-firmware-strict' 'Require exact matches from the validation profile'; \
	print_help_line '  capture-validation-profile' 'Snapshot the current build into a profile JSON'; \
	print_help_line '  clean' 'Remove build output, packaging by-products, and buildbox state'; \
	printf '\n%s\n\n' 'buildbox targets'; \
	print_help_line '  buildbox-up' 'Start or reuse the persistent build container'; \
	print_help_line '  buildbox-down' 'Remove the persistent build container if it exists'; \
	print_help_line '  buildbox-metadata' 'Print resolved build metadata inside the buildbox'; \
	print_help_line '  buildbox-firmware-build' 'Build firmware inside the buildbox'; \
	print_help_line '  buildbox-firmware-stage' 'Stage deployable firmware on the host under dist/firmware/'; \
	print_help_line '  buildbox-o6' 'Compatibility alias for buildbox-firmware-build'; \
	print_help_line '  buildbox-o6-log' 'Capture a full logged buildbox firmware build'; \
	print_help_line '  buildbox-deb' 'Build the Debian package inside the buildbox'; \
	print_help_line '  buildbox-zip' 'Create a .zip archive inside the buildbox'; \
	print_help_line '  buildbox-targz' 'Create a .tar.gz archive inside the buildbox'; \
	print_help_line '  buildbox-validate-firmware' 'Run validation inside the buildbox'; \
	print_help_line '  buildbox-validate-firmware-strict' 'Run strict validation inside the buildbox'; \
	print_help_line '  buildbox-capture-validation-profile' 'Capture a validation profile inside the buildbox'; \
	printf '\n%s\n\n' 'useful variables'; \
	print_help_line '  ARTEFACT_MODE=custom|upstream' 'Select the custom or upstream output mode'; \
	print_help_line '  V=1' 'Show raw EDK2 command lines'; \
	print_help_line '  FIRMWARE_BOARD=O6' 'Select the firmware board'; \
	print_help_line '  FIRMWARE_VALIDATION_PROFILE=<name>' 'Override the validation profile'; \
	print_help_line '  BUILDBOX_PLATFORM=linux/amd64|linux/arm64' 'Force the buildbox container architecture'; \
	print_help_line '  BUILDBOX_IMAGE=<image>' 'Override the buildbox base image'; \
	printf '\n%s\n' 'For lower-level firmware targets, run: make -C src help'

.PHONY: build-edk2
build-edk2:
	$(MAKE) --no-print-directory -C "$(REPO_ROOT)/src"

.PHONY: firmware-build
firmware-build:
	$(MAKE) --no-print-directory -C "$(REPO_ROOT)/src" $(FIRMWARE_SRC_BUILD_TARGETS)
	@if [ "$(FIRMWARE_VALIDATE_ON_BUILD)" = "1" ]; then \
		printf '\n[validate] Checking artefacts against %s\n' "$(FIRMWARE_VALIDATION_PROFILE)"; \
		mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"; \
		python3 "$(REPO_ROOT)/scripts/validate_firmware_outputs.py" \
			--repo-root "$(REPO_ROOT)" \
			--board "$(FIRMWARE_BOARD)" \
			--target "$(FIRMWARE_TARGET)" \
			--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
			--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json"; \
	fi

.PHONY: firmware-stage
firmware-stage: firmware-build
	python3 "$(REPO_ROOT)/scripts/export_firmware_payload.py" stage \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(FIRMWARE_TARGET)" \
		--version "$(FIRMWARE_VERSION)" \
		--output-dir "$(FIRMWARE_STAGE_ROOT)"

.PHONY: install
install: firmware-stage
	python3 "$(REPO_ROOT)/scripts/export_firmware_payload.py" install \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(FIRMWARE_TARGET)" \
		--version "$(FIRMWARE_VERSION)" \
		--install-root "$(FIRMWARE_INSTALL_ROOT)"

.PHONY: zip
zip: firmware-build
	python3 "$(REPO_ROOT)/scripts/export_firmware_payload.py" zip \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(FIRMWARE_TARGET)" \
		--version "$(FIRMWARE_VERSION)" \
		--output "$(FIRMWARE_ARCHIVE_ROOT)/$(FIRMWARE_ARCHIVE_BASENAME).zip"

.PHONY: targz
targz: firmware-build
	python3 "$(REPO_ROOT)/scripts/export_firmware_payload.py" targz \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(FIRMWARE_TARGET)" \
		--version "$(FIRMWARE_VERSION)" \
		--output "$(FIRMWARE_ARCHIVE_ROOT)/$(FIRMWARE_ARCHIVE_BASENAME).tar.gz"

.PHONY: validate-firmware
validate-firmware:
	@mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"
	python3 "$(REPO_ROOT)/scripts/validate_firmware_outputs.py" \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--target "$(FIRMWARE_TARGET)" \
		--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
		--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json"

.PHONY: validate-firmware-strict
validate-firmware-strict:
	@mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"
	python3 "$(REPO_ROOT)/scripts/validate_firmware_outputs.py" \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--target "$(FIRMWARE_TARGET)" \
		--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
		--strict \
		--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json"

.PHONY: capture-validation-profile
capture-validation-profile:
	@mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"
	python3 "$(REPO_ROOT)/scripts/validate_firmware_outputs.py" \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--target "$(FIRMWARE_TARGET)" \
		--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
		--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json" \
		--emit-profile "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(FIRMWARE_TARGET)-profile.json" \
		--emit-profile-name "$(FIRMWARE_VALIDATION_PROFILE)"

clean: clean-edk2
clean: clean-buildbox

.PHONY: clean-edk2
clean-edk2:
	$(MAKE) --no-print-directory -C "$(REPO_ROOT)/src" clean

.PHONY: buildbox-down
buildbox-down:
	@container_name="$${EDK2_CIX_BUILDBOX_NAME:-edk2-cix-buildbox}"; \
	requested_runtime="$${EDK2_CIX_CONTAINER_RUNTIME:-}"; \
	removed=0; \
	found_runtime=0; \
	if [ -n "$$requested_runtime" ]; then \
		runtimes="$$requested_runtime podman docker"; \
	else \
		runtimes="podman docker"; \
	fi; \
	for runtime in $$runtimes; do \
		command -v "$$runtime" >/dev/null 2>&1 || continue; \
		found_runtime=1; \
		if "$$runtime" container inspect "$$container_name" >/dev/null 2>&1; then \
			printf '[clean] Removing buildbox container %s via %s\n' "$$container_name" "$$runtime"; \
			"$$runtime" rm -f "$$container_name" >/dev/null; \
			removed=1; \
			break; \
		fi; \
	done; \
	if [ "$$removed" -eq 0 ]; then \
		if [ "$$found_runtime" -eq 0 ]; then \
			printf '%s\n' '[clean] No container runtime available; skipping buildbox cleanup'; \
		else \
			printf '%s\n' '[clean] No buildbox container to remove'; \
		fi; \
	fi

.PHONY: clean-buildbox
clean-buildbox: buildbox-down
	@if [ -d "$(BUILDBOX_HOST_TMPDIR)" ]; then \
		printf '[clean] Removing buildbox scratch %s\n' "$(BUILDBOX_HOST_TMPDIR)"; \
		rm -rf "$(BUILDBOX_HOST_TMPDIR)"; \
	fi

.PHONY: buildbox-up
buildbox-up:
	$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" true

.PHONY: buildbox-deb
buildbox-deb:
	$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" --dep-profile packaging \
		bash -lc 'set -euo pipefail; repo_root="$$(pwd -P)"; parent_dir="$$(dirname "$$repo_root")"; output_dir="$(BUILDBOX_DEB_RESULT_ROOT_IN_CONTAINER)"; package_name="$$(dpkg-parsechangelog -S Source)"; mkdir -p "$$output_dir"; make --no-print-directory deb; find "$$parent_dir" -maxdepth 1 -type f \( -name "$$package_name"_*.deb -o -name "$$package_name"_*.udeb -o -name "$$package_name"_*.changes -o -name "$$package_name"_*.buildinfo -o -name "$$package_name"_*.build \) -exec cp -f -t "$$output_dir" {} +'

.PHONY: buildbox-firmware-build
buildbox-firmware-build:
	$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" make --no-print-directory firmware-build \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-o6
buildbox-o6: buildbox-firmware-build

.PHONY: buildbox-o6-log
buildbox-o6-log:
	$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/capture_build_log.sh" "$(BUILD_LOG_ROOT)" \
		"$(REPO_ROOT)/scripts/run_in_buildbox.sh" \
		make --no-print-directory firmware-build $(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-firmware-stage
buildbox-firmware-stage:
	$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" make --no-print-directory firmware-stage \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-zip
buildbox-zip:
	$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" make --no-print-directory zip \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-targz
buildbox-targz:
	$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" make --no-print-directory targz \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-validate-firmware
buildbox-validate-firmware:
	$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" make --no-print-directory validate-firmware \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-validate-firmware-strict
buildbox-validate-firmware-strict:
	$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" make --no-print-directory validate-firmware-strict \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-capture-validation-profile
buildbox-capture-validation-profile:
	$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" make --no-print-directory capture-validation-profile \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-metadata
buildbox-metadata:
	$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" make --no-print-directory -C src print-build-metadata
