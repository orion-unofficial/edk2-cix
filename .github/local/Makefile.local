buildbox-validate-firmware buildbox-validate-secure-boot-defaults buildbox-validate-firmware-strict buildbox-audit-final-image-manifest buildbox-audit-acpi-regression buildbox-audit-bundle buildbox-capture-validation-profile: preflight-wrapper-validation preflight-wrapper-buildbox

.PHONY: build-edk2 __build-edk2
build-edk2:
	$(Q)$(LOCKED_MAKE) __build-edk2 V="$(V)"

__build-edk2:
	$(Q)$(MAKE) --no-print-directory -C "$(REPO_ROOT)/src" V="$(V)" \
		$(SRC_COMMON_ARGS) \
		FIRMWARE_TARGET="$(FIRMWARE_TARGET)"

.PHONY: firmware-build __firmware-build
firmware-build:
	$(Q)$(LOCKED_MAKE) __firmware-build V="$(V)"

__firmware-build:
	$(Q)$(MAKE) --no-print-directory -C "$(REPO_ROOT)/src" V="$(V)" \
		$(SRC_COMMON_ARGS) \
		FIRMWARE_TARGET="$(FIRMWARE_TARGET)" $(FIRMWARE_SRC_BUILD_TARGETS)
	@if [ "$(FIRMWARE_VALIDATE_ON_BUILD_EFFECTIVE)" = "1" ]; then \
		printf '\n[validate] Checking artefacts against %s\n' "$(FIRMWARE_VALIDATION_PROFILE)"; \
		mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"; \
		python3 "$(REPO_ROOT)/scripts/validate_firmware_outputs.py" \
			--repo-root "$(REPO_ROOT)" \
			--board "$(FIRMWARE_BOARD)" \
			--target "$(RAW_FIRMWARE_TARGET)" \
			--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
		--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(RAW_FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json"; \
	fi
	@if [ "$(EDK2_CIX_SUPPRESS_FINAL_OUTPUT)" != "1" ]; then \
		printf '[output] Raw firmware images available under %s\n' "$(REPO_ROOT)/src/Build/$(FIRMWARE_BOARD)/$(RAW_FIRMWARE_TARGET)"; \
	fi

.PHONY: __firmware-build-silent-output
__firmware-build-silent-output:
	$(Q)$(MAKE) --no-print-directory __firmware-build V="$(V)" EDK2_CIX_SUPPRESS_FINAL_OUTPUT=1

.PHONY: firmware-stage __firmware-stage
firmware-stage:
	$(Q)$(LOCKED_MAKE) __firmware-stage V="$(V)"

__firmware-stage: __firmware-build-silent-output
	$(Q)EDK2_CIX_SUPPRESS_EXPORT_OUTPUT=1 python3 "$(REPO_ROOT)/scripts/export_firmware_payload.py" stage \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(RAW_FIRMWARE_TARGET)" \
		--artefact-mode "$(ARTEFACT_MODE)" \
		--version "$(FIRMWARE_VERSION)" \
		--output-dir "$(FIRMWARE_STAGE_ROOT)"
	@if [ "$(EDK2_CIX_SUPPRESS_FINAL_OUTPUT)" != "1" ]; then \
		printf '[output] Staged firmware payload available under %s\n' "$(FIRMWARE_STAGE_ROOT)"; \
	fi

.PHONY: install __install
install:
	$(Q)$(LOCKED_MAKE) __install V="$(V)"

__install: __firmware-stage
	$(Q)EDK2_CIX_SUPPRESS_EXPORT_OUTPUT=1 python3 "$(REPO_ROOT)/scripts/export_firmware_payload.py" install \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(RAW_FIRMWARE_TARGET)" \
		--artefact-mode "$(ARTEFACT_MODE)" \
		--version "$(FIRMWARE_VERSION)" \
		--install-root "$(FIRMWARE_INSTALL_ROOT)"
	@if [ "$(EDK2_CIX_SUPPRESS_FINAL_OUTPUT)" != "1" ]; then \
		printf '[output] Installed firmware payload available under %s\n' "$(FIRMWARE_INSTALL_ROOT)/$(FIRMWARE_VERSION)"; \
	fi

.PHONY: zip __zip
zip:
	$(Q)$(LOCKED_MAKE) __zip V="$(V)"

__zip: __firmware-build-silent-output
	$(Q)EDK2_CIX_SUPPRESS_EXPORT_OUTPUT=1 python3 "$(REPO_ROOT)/scripts/export_firmware_payload.py" zip \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(RAW_FIRMWARE_TARGET)" \
		--artefact-mode "$(ARTEFACT_MODE)" \
		--version "$(FIRMWARE_VERSION)" \
		--output "$(FIRMWARE_ARCHIVE_ROOT)/$(FIRMWARE_ARCHIVE_BASENAME).zip"
	@if [ "$(EDK2_CIX_SUPPRESS_FINAL_OUTPUT)" != "1" ]; then \
		printf '[output] Firmware archive available at %s\n' "$(FIRMWARE_ARCHIVE_ROOT)/$(FIRMWARE_ARCHIVE_BASENAME).zip"; \
	fi

.PHONY: targz __targz
targz:
	$(Q)$(LOCKED_MAKE) __targz V="$(V)"

__targz: __firmware-build-silent-output
	$(Q)EDK2_CIX_SUPPRESS_EXPORT_OUTPUT=1 python3 "$(REPO_ROOT)/scripts/export_firmware_payload.py" targz \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(RAW_FIRMWARE_TARGET)" \
		--artefact-mode "$(ARTEFACT_MODE)" \
		--version "$(FIRMWARE_VERSION)" \
		--output "$(FIRMWARE_ARCHIVE_ROOT)/$(FIRMWARE_ARCHIVE_BASENAME).tar.gz"
	@if [ "$(EDK2_CIX_SUPPRESS_FINAL_OUTPUT)" != "1" ]; then \
		printf '[output] Firmware archive available at %s\n' "$(FIRMWARE_ARCHIVE_ROOT)/$(FIRMWARE_ARCHIVE_BASENAME).tar.gz"; \
	fi

.PHONY: validate-firmware __validate-firmware
validate-firmware:
	$(Q)$(LOCKED_MAKE) __validate-firmware V="$(V)"

__validate-firmware:
	@mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"
	$(Q)python3 "$(REPO_ROOT)/scripts/validate_firmware_outputs.py" \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--target "$(RAW_FIRMWARE_TARGET)" \
		--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
		--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(RAW_FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json"

.PHONY: validate-firmware-strict __validate-firmware-strict
validate-firmware-strict:
	$(Q)$(LOCKED_MAKE) __validate-firmware-strict V="$(V)"

__validate-firmware-strict:
	@mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"
	$(Q)python3 "$(REPO_ROOT)/scripts/validate_firmware_outputs.py" \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--target "$(RAW_FIRMWARE_TARGET)" \
		--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
		--strict \
		--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(RAW_FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json"

.PHONY: check-offline-audit-baselines __check-offline-audit-baselines
check-offline-audit-baselines:
	$(Q)$(LOCKED_MAKE) __check-offline-audit-baselines V="$(V)"

__check-offline-audit-baselines:
	$(Q)python3 "$(REPO_ROOT)/scripts/test_offline_audit_baselines.py"

.PHONY: audit-final-image-manifest __audit-final-image-manifest
audit-final-image-manifest:
	$(Q)$(LOCKED_MAKE) __audit-final-image-manifest V="$(V)"

__audit-final-image-manifest:
	$(Q)$(MAKE) --no-print-directory check-offline-audit-baselines V="$(V)"
	@mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"
	$(Q)$(MAKE) --no-print-directory -C "$(REPO_ROOT)/src" V="$(V)" \
		$(SRC_COMMON_ARGS) \
		FIRMWARE_TARGET="$(FIRMWARE_TARGET)" \
		FIRMWARE_VALIDATION_PROFILE="$(FIRMWARE_VALIDATION_PROFILE)" \
		FIRMWARE_VALIDATION_REPORT_ROOT="$(FIRMWARE_VALIDATION_REPORT_ROOT)" \
		audit-final-image-manifest-$(FIRMWARE_BOARD)

.PHONY: audit-acpi-regression __audit-acpi-regression
audit-acpi-regression:
	$(Q)$(LOCKED_MAKE) __audit-acpi-regression V="$(V)"

__audit-acpi-regression:
	$(Q)$(MAKE) --no-print-directory check-offline-audit-baselines V="$(V)"
	@mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"
	$(Q)$(MAKE) --no-print-directory -C "$(REPO_ROOT)/src" V="$(V)" \
		$(SRC_COMMON_ARGS) \
		FIRMWARE_TARGET="$(FIRMWARE_TARGET)" \
		FIRMWARE_VALIDATION_PROFILE="$(FIRMWARE_VALIDATION_PROFILE)" \
		FIRMWARE_VALIDATION_REPORT_ROOT="$(FIRMWARE_VALIDATION_REPORT_ROOT)" \
		audit-acpi-regression-$(FIRMWARE_BOARD)

.PHONY: refresh-offline-audit-baselines __refresh-offline-audit-baselines
refresh-offline-audit-baselines:
	$(Q)$(LOCKED_MAKE) __refresh-offline-audit-baselines V="$(V)"

__refresh-offline-audit-baselines:
	$(Q)$(MAKE) --no-print-directory check-offline-audit-baselines V="$(V)"
	@mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"
	$(Q)$(MAKE) --no-print-directory -C "$(REPO_ROOT)/src" V="$(V)" \
		$(SRC_COMMON_ARGS) \
		FIRMWARE_TARGET="$(FIRMWARE_TARGET)" \
		FIRMWARE_VALIDATION_PROFILE="$(FIRMWARE_VALIDATION_PROFILE)" \
		FIRMWARE_VALIDATION_REPORT_ROOT="$(FIRMWARE_VALIDATION_REPORT_ROOT)" \
		refresh-offline-audit-baselines-$(FIRMWARE_BOARD)
	$(Q)$(MAKE) --no-print-directory check-offline-audit-baselines V="$(V)"

.PHONY: audit-bundle __audit-bundle
audit-bundle:
	$(Q)$(LOCKED_MAKE) __audit-bundle V="$(V)"

__audit-bundle:
	$(Q)$(MAKE) --no-print-directory check-offline-audit-baselines V="$(V)"
	$(Q)$(MAKE) --no-print-directory firmware-build V="$(V)" EDK2_CIX_SUPPRESS_FINAL_OUTPUT=1
	$(Q)$(MAKE) --no-print-directory validate-firmware-strict V="$(V)"
	$(Q)$(MAKE) --no-print-directory audit-final-image-manifest V="$(V)"
	$(Q)$(MAKE) --no-print-directory audit-acpi-regression V="$(V)"
	$(Q)python3 "$(REPO_ROOT)/scripts/test_firmware_metadata_audit.py"
	@if [ -n "$(strip $(MONOREPO_META_ROOT))" ]; then \
		python3 "$(MONOREPO_META_ROOT)/scripts/monorepo/check_metadata_consistency.py" \
			--metadata-root "$(MONOREPO_META_ROOT)" \
			--source-repo "$(REPO_ROOT)"; \
	fi

.PHONY: capture-validation-profile __capture-validation-profile
capture-validation-profile:
	$(Q)$(LOCKED_MAKE) __capture-validation-profile V="$(V)"

__capture-validation-profile:
	@mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"
	$(Q)python3 "$(REPO_ROOT)/scripts/validate_firmware_outputs.py" \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--target "$(RAW_FIRMWARE_TARGET)" \
		--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
		--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(RAW_FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json" \
		--emit-profile "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(RAW_FIRMWARE_TARGET)-profile.json" \
		--emit-profile-name "$(FIRMWARE_VALIDATION_PROFILE)"

.PHONY: deterministic-replay __deterministic-replay
deterministic-replay:
	$(Q)$(LOCKED_MAKE) __deterministic-replay V="$(V)"

__deterministic-replay:
	@set -euo pipefail; \
	replay_board="$(FIRMWARE_BOARD)"; \
	replay_dir="$(DETERMINISTIC_REPLAY_ROOT)"; \
	replay_input='$(strip $(REPLAY_INPUT))'; \
	replay_build_options='$(strip $(REPLAY_BUILD_OPTIONS))'; \
	replay_build_date='$(strip $(REPLAY_BUILD_DATE))'; \
	validation_file="$(REPO_ROOT)/validation/expected-hashes.json"; \
	if [ ! -f "$$validation_file" ]; then \
		echo "[replay] No checked-in exact replay validation data exists for board $$replay_board." >&2; \
		echo "[replay] Expected: $$validation_file" >&2; \
		exit 2; \
	fi; \
	if [ -n "$$replay_input" ]; then \
		printf '[replay] Extracting exact replay inputs into %s\n' "$$replay_dir"; \
		rm -rf "$$replay_dir"; \
		mkdir -p "$$replay_dir"; \
		replay_cmd=(python3 "$(REPO_ROOT)/src/scripts/replay_o6_release.py" "$$replay_input" --board "$$replay_board" --output-dir "$$replay_dir"); \
		if [ -n "$$replay_build_options" ]; then \
			replay_cmd+=(--build-options "$$replay_build_options"); \
		fi; \
		if [ -n "$$replay_build_date" ]; then \
			replay_cmd+=(--build-date "$$replay_build_date"); \
		fi; \
		"$${replay_cmd[@]}"; \
	elif [ ! -f "$$replay_dir/replay.env" ]; then \
		echo "[replay] No cached replay inputs found at $$replay_dir/replay.env" >&2; \
		echo "[replay] Re-run with REPLAY_INPUT=/path/to/edk2-cix_*.deb" >&2; \
		echo "[replay] or REPLAY_INPUT=/path/to/cix_flash_all.bin plus REPLAY_BUILD_OPTIONS=/path/to/BuildOptions." >&2; \
		exit 2; \
	else \
		printf '[replay] Reusing cached replay inputs from %s\n' "$$replay_dir"; \
	fi; \
	if [ ! -f "$$replay_dir/replay.env" ]; then \
		echo "[replay] Expected $$replay_dir/replay.env after preparing replay inputs." >&2; \
		exit 2; \
	fi; \
	set -a; . "$$replay_dir/replay.env"; set +a; \
	replay_mount_root="$(DETERMINISTIC_REPLAY_MOUNT_ROOT)"; \
	replay_cert_dir_host="$$SIGNING_CERT_SOURCE_DIR"; \
	case "$$replay_cert_dir_host" in \
		"$$replay_mount_root"/*) \
			replay_cert_dir_container="/hosttmp/$${replay_cert_dir_host#$$replay_mount_root/}"; \
			;; \
		*) \
			echo "[replay] Cached cert bundle $$replay_cert_dir_host is outside $$replay_mount_root and cannot be mounted into the buildbox." >&2; \
			echo "[replay] Move the replay cache under $$replay_mount_root or override DETERMINISTIC_REPLAY_MOUNT_ROOT accordingly." >&2; \
			exit 2; \
			;; \
	esac; \
	printf '[replay] Running %s in %s using %s\n' "$(DETERMINISTIC_REPLAY_PROFILE)" "$(FIRMWARE_DISTRO)" "$(DETERMINISTIC_REPLAY_IMAGE)"; \
	$(BUILDBOX_ENV) EDK2_CIX_HOST_TMPDIR="$$replay_mount_root" EDK2_CIX_CONTAINER_TMPDIR="/hosttmp" EDK2_CIX_BUILDBOX_IMAGE="$(DETERMINISTIC_REPLAY_IMAGE)" \
		"$(REPO_ROOT)/scripts/run_in_buildbox.sh" \
		make --no-print-directory -C src clean V="$(V)"; \
	$(BUILDBOX_ENV) EDK2_CIX_HOST_TMPDIR="$$replay_mount_root" EDK2_CIX_CONTAINER_TMPDIR="/hosttmp" EDK2_CIX_BUILDBOX_IMAGE="$(DETERMINISTIC_REPLAY_IMAGE)" \
		"$(REPO_ROOT)/scripts/run_in_buildbox.sh" \
		make --no-print-directory firmware-build V="$(V)" \
		ARTEFACT_MODE="upstream" \
		FIRMWARE_BOARD="$(FIRMWARE_BOARD)" \
		FIRMWARE_PRODUCT="$(REPLAY_PRODUCT)" \
		FIRMWARE_TARGET="$(FIRMWARE_TARGET)" \
		FIRMWARE_VERSION="$(REPLAY_VERSION)" \
		FIRMWARE_VALIDATION_PROFILE="$(DETERMINISTIC_REPLAY_PROFILE)" \
		BUILD_DATE="$$BUILD_DATE" \
		SOURCE_DATE_EPOCH="$$SOURCE_DATE_EPOCH" \
		PM_CONFIG_SOURCE_DATE_EPOCH="$$PM_CONFIG_SOURCE_DATE_EPOCH" \
		SIGNING_CERT_SOURCE_DIR="$$replay_cert_dir_container" \
		SOURCE_COMMIT_HASH="$${SOURCE_COMMIT_HASH:-}" \
		EDK2_COMMIT_HASH="$${EDK2_COMMIT_HASH:-}" \
		EDK2_NON_OSI_COMMIT_HASH="$${EDK2_NON_OSI_COMMIT_HASH:-}" \
		EDK2_PLATFORMS_COMMIT_HASH="$${EDK2_PLATFORMS_COMMIT_HASH:-}"; \
	reference_dir="$$replay_dir/reference"; \
	if [ -d "$$reference_dir" ]; then \
		printf '[replay] Comparing built outputs against upstream release payload in %s\n' "$$reference_dir"; \
		mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"; \
		python3 "$(REPO_ROOT)/scripts/compare_release_payloads.py" \
			--build-dir "$(REPO_ROOT)/src/Build/$(FIRMWARE_BOARD)/$(RAW_FIRMWARE_TARGET)" \
			--reference-dir "$$reference_dir" \
			--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(RAW_FIRMWARE_TARGET)-$(DETERMINISTIC_REPLAY_PROFILE)-release-compare.json" \
			--strict; \
	else \
		printf '[replay] No preserved upstream release payload found at %s; skipping direct release comparison\n' "$$reference_dir"; \
	fi; \
	$(BUILDBOX_ENV) EDK2_CIX_HOST_TMPDIR="$$replay_mount_root" EDK2_CIX_CONTAINER_TMPDIR="/hosttmp" EDK2_CIX_BUILDBOX_IMAGE="$(DETERMINISTIC_REPLAY_IMAGE)" \
		"$(REPO_ROOT)/scripts/run_in_buildbox.sh" \
		make --no-print-directory validate-firmware-strict V="$(V)" \
		FIRMWARE_BOARD="$(FIRMWARE_BOARD)" \
		FIRMWARE_PRODUCT="$(REPLAY_PRODUCT)" \
		FIRMWARE_TARGET="$(FIRMWARE_TARGET)" \
		FIRMWARE_VERSION="$(REPLAY_VERSION)" \
		FIRMWARE_VALIDATION_PROFILE="$(DETERMINISTIC_REPLAY_PROFILE)"

.PHONY: gha-act-list __gha-act-list
gha-act-list:
	$(Q)$(LOCKED_MAKE) __gha-act-list V="$(V)"

__gha-act-list:
	@set -euo pipefail; \
	args=(); \
	if [ -n "$(strip $(ACT_WORKFLOW))" ]; then \
		args+=(-W "$(strip $(ACT_WORKFLOW))"); \
	fi; \
	"$(REPO_ROOT)/scripts/run_github_actions_with_act.sh" "$${args[@]}" -l

.PHONY: gha-act-dry-run __gha-act-dry-run
gha-act-dry-run:
	$(Q)$(LOCKED_MAKE) __gha-act-dry-run V="$(V)"

__gha-act-dry-run:
	@set -euo pipefail; \
	workflow="$(strip $(ACT_WORKFLOW))"; \
	if [ -z "$$workflow" ]; then \
		echo "[act] Set ACT_WORKFLOW=.github/workflows/<file>.yaml for gha-act-dry-run." >&2; \
		exit 2; \
	fi; \
	args=("$(ACT_EVENT)" -W "$$workflow" -n); \
	if [ -n "$(strip $(ACT_JOB))" ]; then \
		args+=(-j "$(strip $(ACT_JOB))"); \
	fi; \
	if [ -n "$(strip $(ACT_MATRIX))" ]; then \
		args+=(--matrix "$(strip $(ACT_MATRIX))"); \
	fi; \
	if [ -n "$(strip $(ACT_SECRET_FILE))" ]; then \
		args+=(--secret-file "$(strip $(ACT_SECRET_FILE))"); \
	fi; \
	if [ -n "$(strip $(ACT_EXTRA_ARGS))" ]; then \
		extra_args=( $(ACT_EXTRA_ARGS) ); \
		args+=("$${extra_args[@]}"); \
	fi; \
	"$(REPO_ROOT)/scripts/run_github_actions_with_act.sh" "$${args[@]}"

.PHONY: gha-act-run __gha-act-run
gha-act-run:
	$(Q)$(LOCKED_MAKE) __gha-act-run V="$(V)"

__gha-act-run:
	@set -euo pipefail; \
	workflow="$(strip $(ACT_WORKFLOW))"; \
	if [ -z "$$workflow" ]; then \
		echo "[act] Set ACT_WORKFLOW=.github/workflows/<file>.yaml for gha-act-run." >&2; \
		exit 2; \
	fi; \
	args=("$(ACT_EVENT)" -W "$$workflow"); \
	if [ -n "$(strip $(ACT_JOB))" ]; then \
		args+=(-j "$(strip $(ACT_JOB))"); \
	fi; \
	if [ -n "$(strip $(ACT_MATRIX))" ]; then \
		args+=(--matrix "$(strip $(ACT_MATRIX))"); \
	fi; \
	if [ -n "$(strip $(ACT_SECRET_FILE))" ]; then \
		args+=(--secret-file "$(strip $(ACT_SECRET_FILE))"); \
	fi; \
	if [ -n "$(strip $(ACT_EXTRA_ARGS))" ]; then \
		extra_args=( $(ACT_EXTRA_ARGS) ); \
		args+=("$${extra_args[@]}"); \
	fi; \
	"$(REPO_ROOT)/scripts/run_github_actions_with_act.sh" "$${args[@]}"

.PHONY: gha-act-run-clean __gha-act-run-clean
gha-act-run-clean:
