		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-audit-final-image-manifest __buildbox-audit-final-image-manifest
buildbox-audit-final-image-manifest:
	$(Q)$(LOCKED_MAKE) __buildbox-audit-final-image-manifest V="$(V)"

__buildbox-audit-final-image-manifest:
	$(Q)$(VALIDATION_BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" make --no-print-directory audit-final-image-manifest V="$(V)" \
		$(BUILDBOX_FIRMWARE_ARGS)

