__buildbox-capture-validation-profile:
	$(Q)$(VALIDATION_BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" make --no-print-directory capture-validation-profile V="$(V)" \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-metadata __buildbox-metadata
buildbox-metadata:
	$(Q)$(LOCKED_MAKE) __buildbox-metadata V="$(V)"

__buildbox-metadata:
	$(Q)$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" make --no-print-directory -C src print-build-metadata V="$(V)" \
		$(SRC_COMMON_ARGS) \
		CCACHE_DIR="$(CCACHE_DIR_IN_CONTAINER)" \
		CCACHE_WRAPPER_ROOT="$(CCACHE_WRAPPER_ROOT_IN_CONTAINER)" \
		FIRMWARE_TARGET="$(FIRMWARE_TARGET)" \
		FIRMWARE_VERSION="$(FIRMWARE_VERSION)"

.PHONY: buildbox-ccache-stats __buildbox-ccache-stats
buildbox-ccache-stats:
	$(Q)$(LOCKED_MAKE) __buildbox-ccache-stats V="$(V)"

__buildbox-ccache-stats:
	@set -euo pipefail; \
	stats_log="$$(mktemp "$(REPO_ROOT)/.buildbox/tmp/ccache-stats.XXXXXX")"; \
	if ! $(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" \
		python3 "$(BUILDBOX_WORKSPACE_ROOT)/scripts/ccache_stats.py" \
			--cache-dir "$(CCACHE_DIR_IN_CONTAINER)" \
			$(if $(strip $(CCACHE_BIN)),--ccache-bin "$(CCACHE_BIN)") >"$$stats_log" 2>&1; then \
		cat "$$stats_log" >&2; \
		rm -f "$$stats_log"; \
		exit 1; \
	fi; \
	python3 "$(REPO_ROOT)/scripts/format_ccache_stats.py" --format "$(CCACHE_STATS_FORMAT)" "$$stats_log"; \
	rm -f "$$stats_log"
