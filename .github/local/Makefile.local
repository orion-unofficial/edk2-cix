PROJECT ?= edk2-cix
FIRMWARE_BOARD ?= O6
FIRMWARE_PRODUCT ?= orion-o6
FIRMWARE_TARGET ?= RELEASE_GCC5
FIRMWARE_VERSION ?= $(shell dpkg-parsechangelog -S Version 2>/dev/null || sed -n '1s/^[^(]*(\([^)]*\)).*/\1/p' debian/changelog)
FIRMWARE_STAGE_ROOT ?= $(CURDIR)/dist/firmware/$(FIRMWARE_PRODUCT)/$(FIRMWARE_VERSION)
FIRMWARE_INSTALL_ROOT ?= /boot/efi/firmware/radxa
FIRMWARE_ARCHIVE_ROOT ?= $(CURDIR)/dist
FIRMWARE_ARCHIVE_BASENAME ?= edk2-cix-$(FIRMWARE_PRODUCT)-$(FIRMWARE_VERSION)
FIRMWARE_VALIDATION_PROFILE ?= upstream-o6-1.2.1-bookworm
FIRMWARE_VALIDATION_REPORT_ROOT ?= $(CURDIR)/build-validation
FIRMWARE_VALIDATE_ON_BUILD ?= $(if $(filter upstream,$(ARTEFACT_MODE)),1,0)
FIRMWARE_SRC_BUILD_TARGETS = \
	Build/$(FIRMWARE_BOARD)/$(FIRMWARE_TARGET)/cix_flash_all.bin \
	Build/$(FIRMWARE_BOARD)/$(FIRMWARE_TARGET)/cix_flash_ota.bin
BUILDBOX_FIRMWARE_ARGS = \
	ARTEFACT_MODE="$(ARTEFACT_MODE)" \
	FIRMWARE_BOARD="$(FIRMWARE_BOARD)" \
	FIRMWARE_PRODUCT="$(FIRMWARE_PRODUCT)" \
	FIRMWARE_TARGET="$(FIRMWARE_TARGET)" \
	FIRMWARE_VERSION="$(FIRMWARE_VERSION)" \
	FIRMWARE_STAGE_ROOT="/workspaces/edk2-cix/dist/firmware/$(FIRMWARE_PRODUCT)/$(FIRMWARE_VERSION)" \
	FIRMWARE_ARCHIVE_ROOT="/workspaces/edk2-cix/dist" \
	FIRMWARE_VALIDATION_PROFILE="$(FIRMWARE_VALIDATION_PROFILE)" \
	FIRMWARE_VALIDATION_REPORT_ROOT="/workspaces/edk2-cix/build-validation"

src/tools/gcc/gcc-arm-10.2-2020.11-x86_64-aarch64-none-elf.tar.xz:
	mkdir -p src/tools/gcc
	wget -O $@ \
	"https://developer.arm.com/-/media/files/downloads/gnu-a/10.2-2020.11/binrel/gcc-arm-10.2-2020.11-x86_64-aarch64-none-elf.tar.xz"

src/tools/gcc/%: src/tools/gcc/%.tar.xz
	tar xvf $< -C src/tools/gcc/

build: build-edk2

.PHONY: help
help:
	@printf '%s\n' 'edk2-cix common targets'
	@printf '%s\n' ''
	@printf '%-34s %s\n' '  help' 'Show this help text'
	@printf '%-34s %s\n' '  devcontainer_setup' 'Install host build dependencies'
	@printf '%-34s %s\n' '  build-edk2' 'Run the raw src/ firmware build'
	@printf '%-34s %s\n' '  firmware-build' 'Build the O6 firmware artefacts'
	@printf '%-34s %s\n' '  firmware-stage' 'Stage deployable firmware files under dist/'
	@printf '%-34s %s\n' '  install' 'Install staged firmware files under /boot/efi/'
	@printf '%-34s %s\n' '  zip' 'Create a .zip firmware archive'
	@printf '%-34s %s\n' '  targz' 'Create a .tar.gz firmware archive'
	@printf '%-34s %s\n' '  deb' 'Build the Debian package'
	@printf '%-34s %s\n' '  validate-firmware' 'Check outputs against the active validation profile'
	@printf '%-34s %s\n' '  validate-firmware-strict' 'Require exact matches from the validation profile'
	@printf '%-34s %s\n' '  capture-validation-profile' 'Snapshot the current build into a profile JSON'
	@printf '%-34s %s\n' '  clean' 'Remove build output and packaging by-products'
	@printf '%s\n' ''
	@printf '%s\n' 'buildbox targets'
	@printf '%s\n' ''
	@printf '%-34s %s\n' '  buildbox-up' 'Start or reuse the persistent build container'
	@printf '%-34s %s\n' '  buildbox-metadata' 'Print resolved build metadata inside the buildbox'
	@printf '%-34s %s\n' '  buildbox-firmware-build' 'Build firmware inside the buildbox'
	@printf '%-34s %s\n' '  buildbox-firmware-stage' 'Stage firmware files inside the buildbox'
	@printf '%-34s %s\n' '  buildbox-o6' 'Compatibility alias for buildbox-firmware-build'
	@printf '%-34s %s\n' '  buildbox-o6-log' 'Capture a full logged buildbox firmware build'
	@printf '%-34s %s\n' '  buildbox-deb' 'Build the Debian package inside the buildbox'
	@printf '%-34s %s\n' '  buildbox-zip' 'Create a .zip archive inside the buildbox'
	@printf '%-34s %s\n' '  buildbox-targz' 'Create a .tar.gz archive inside the buildbox'
	@printf '%-34s %s\n' '  buildbox-validate-firmware' 'Run validation inside the buildbox'
	@printf '%-34s %s\n' '  buildbox-validate-firmware-strict' 'Run strict validation inside the buildbox'
	@printf '%-34s %s\n' '  buildbox-capture-validation-profile' 'Capture a validation profile inside the buildbox'
	@printf '%s\n' ''
	@printf '%s\n' 'useful variables'
	@printf '%s\n' ''
	@printf '%-34s %s\n' '  ARTEFACT_MODE=custom|upstream' 'Select the custom or upstream output mode'
	@printf '%-34s %s\n' '  V=1' 'Show raw EDK2 command lines'
	@printf '%-34s %s\n' '  FIRMWARE_BOARD=O6' 'Select the firmware board'
	@printf '%-34s %s\n' '  FIRMWARE_VALIDATION_PROFILE=<name>' 'Override the validation profile'
	@printf '%s\n' ''
	@printf '%s\n' 'For lower-level firmware targets, run: make -C src help'

.PHONY: build-edk2
build-edk2:
	make --no-print-directory -C src

.PHONY: firmware-build
firmware-build:
	make --no-print-directory -C src $(FIRMWARE_SRC_BUILD_TARGETS)
	@if [[ "$(FIRMWARE_VALIDATE_ON_BUILD)" == "1" ]]; then \
		printf '\n[validate] Checking artefacts against %s\n' "$(FIRMWARE_VALIDATION_PROFILE)"; \
		mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"; \
		python3 scripts/validate_firmware_outputs.py \
			--repo-root "$(CURDIR)" \
			--board "$(FIRMWARE_BOARD)" \
			--target "$(FIRMWARE_TARGET)" \
			--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
			--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json"; \
	fi

.PHONY: firmware-stage
firmware-stage: firmware-build
	python3 scripts/export_firmware_payload.py stage \
		--repo-root "$(CURDIR)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(FIRMWARE_TARGET)" \
		--version "$(FIRMWARE_VERSION)" \
		--output-dir "$(FIRMWARE_STAGE_ROOT)"

.PHONY: install
install: firmware-stage
	python3 scripts/export_firmware_payload.py install \
		--repo-root "$(CURDIR)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(FIRMWARE_TARGET)" \
		--version "$(FIRMWARE_VERSION)" \
		--install-root "$(FIRMWARE_INSTALL_ROOT)"

.PHONY: zip
zip: firmware-build
	python3 scripts/export_firmware_payload.py zip \
		--repo-root "$(CURDIR)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(FIRMWARE_TARGET)" \
		--version "$(FIRMWARE_VERSION)" \
		--output "$(FIRMWARE_ARCHIVE_ROOT)/$(FIRMWARE_ARCHIVE_BASENAME).zip"

.PHONY: targz
targz: firmware-build
	python3 scripts/export_firmware_payload.py targz \
		--repo-root "$(CURDIR)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(FIRMWARE_TARGET)" \
		--version "$(FIRMWARE_VERSION)" \
		--output "$(FIRMWARE_ARCHIVE_ROOT)/$(FIRMWARE_ARCHIVE_BASENAME).tar.gz"

.PHONY: validate-firmware
validate-firmware:
	@mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"
	python3 scripts/validate_firmware_outputs.py \
		--repo-root "$(CURDIR)" \
		--board "$(FIRMWARE_BOARD)" \
		--target "$(FIRMWARE_TARGET)" \
		--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
		--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json"

.PHONY: validate-firmware-strict
validate-firmware-strict:
	@mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"
	python3 scripts/validate_firmware_outputs.py \
		--repo-root "$(CURDIR)" \
		--board "$(FIRMWARE_BOARD)" \
		--target "$(FIRMWARE_TARGET)" \
		--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
		--strict \
		--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json"

.PHONY: capture-validation-profile
capture-validation-profile:
	@mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"
	python3 scripts/validate_firmware_outputs.py \
		--repo-root "$(CURDIR)" \
		--board "$(FIRMWARE_BOARD)" \
		--target "$(FIRMWARE_TARGET)" \
		--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
		--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json" \
		--emit-profile "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(FIRMWARE_TARGET)-profile.json" \
		--emit-profile-name "$(FIRMWARE_VALIDATION_PROFILE)"

clean: clean-edk2

.PHONY: clean-edk2
clean-edk2:
	make --no-print-directory -C src clean

.PHONY: buildbox-up
buildbox-up:
	./scripts/run_in_buildbox.sh true

.PHONY: buildbox-deb
buildbox-deb:
	./scripts/run_in_buildbox.sh make --no-print-directory deb

.PHONY: buildbox-firmware-build
buildbox-firmware-build:
	./scripts/run_in_buildbox.sh make --no-print-directory firmware-build \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-o6
buildbox-o6: buildbox-firmware-build

.PHONY: buildbox-o6-log
buildbox-o6-log:
	./scripts/capture_build_log.sh build-logs \
		./scripts/run_in_buildbox.sh \
		make --no-print-directory firmware-build $(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-firmware-stage
buildbox-firmware-stage:
	./scripts/run_in_buildbox.sh make --no-print-directory firmware-stage \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-zip
buildbox-zip:
	./scripts/run_in_buildbox.sh make --no-print-directory zip \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-targz
buildbox-targz:
	./scripts/run_in_buildbox.sh make --no-print-directory targz \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-validate-firmware
buildbox-validate-firmware:
	./scripts/run_in_buildbox.sh make --no-print-directory validate-firmware \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-validate-firmware-strict
buildbox-validate-firmware-strict:
	./scripts/run_in_buildbox.sh make --no-print-directory validate-firmware-strict \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-capture-validation-profile
buildbox-capture-validation-profile:
	./scripts/run_in_buildbox.sh make --no-print-directory capture-validation-profile \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-metadata
buildbox-metadata:
	./scripts/run_in_buildbox.sh make --no-print-directory -C src print-build-metadata
