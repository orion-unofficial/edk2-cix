LOCAL_MAKEFILE := $(abspath $(lastword $(MAKEFILE_LIST)))
REPO_ROOT ?= $(patsubst %/,%,$(abspath $(dir $(LOCAL_MAKEFILE))/../..))
REPO_NAME ?= $(notdir $(REPO_ROOT))
V ?= 0
ifeq ($(V),1)
Q :=
else
Q := @
endif
WITH_REPO_LOCK := "$(REPO_ROOT)/scripts/with_repo_lock.sh"
LOCKED_MAKE = $(if $(filter 1,$(EDK2_CIX_REPO_LOCK_HELD)),$(MAKE) --no-print-directory,$(WITH_REPO_LOCK) $(MAKE) --no-print-directory)
BUILDBOX_WORKSPACE_PARENT ?= /workspaces
BUILDBOX_WORKSPACE_ROOT ?= $(BUILDBOX_WORKSPACE_PARENT)/$(REPO_NAME)
BUILDBOX_HOST_TMPDIR ?= $(REPO_ROOT)/.buildbox/tmp
BUILDBOX_CONTAINER_TMPDIR ?= /hosttmp
BUILDBOX_IMAGE ?=
BUILDBOX_PLATFORM ?=
BUILDBOX_DEB_RESULT_ROOT ?= $(REPO_ROOT)/dist/deb
BUILDBOX_DEB_RESULT_ROOT_IN_CONTAINER ?= $(BUILDBOX_WORKSPACE_ROOT)/dist/deb
BUILD_LOG_ROOT ?= $(REPO_ROOT)/build-logs
BUILDBOX_ENV = \
	EDK2_CIX_WORKSPACE_ROOT="$(BUILDBOX_WORKSPACE_ROOT)" \
	EDK2_CIX_HOST_TMPDIR="$(BUILDBOX_HOST_TMPDIR)" \
	EDK2_CIX_CONTAINER_TMPDIR="$(BUILDBOX_CONTAINER_TMPDIR)" \
	EDK2_CIX_VERBOSE="$(V)" \
	EDK2_CIX_BUILDBOX_IMAGE="$(BUILDBOX_IMAGE)" \
	EDK2_CIX_BUILDBOX_PLATFORM="$(BUILDBOX_PLATFORM)"

PROJECT ?= edk2-cix
ARTEFACT_MODE ?= custom
FIRMWARE_BOARD ?= O6
FIRMWARE_PRODUCT ?= orion-o6
FIRMWARE_TARGET ?= RELEASE_GCC5
FIRMWARE_VERSION ?= $(shell cd "$(REPO_ROOT)" && (dpkg-parsechangelog -S Version 2>/dev/null || sed -n '1s/^[^(]*(\([^)]*\)).*/\1/p' debian/changelog))
FIRMWARE_STAGE_ROOT ?= $(REPO_ROOT)/dist/firmware/$(FIRMWARE_PRODUCT)/$(FIRMWARE_VERSION)
FIRMWARE_INSTALL_ROOT ?= /boot/efi/firmware/radxa
FIRMWARE_ARCHIVE_ROOT ?= $(REPO_ROOT)/dist
FIRMWARE_ARCHIVE_BASENAME ?= edk2-cix-$(FIRMWARE_PRODUCT)-$(FIRMWARE_VERSION)
FIRMWARE_VALIDATION_PROFILE ?= upstream-o6-1.2.1-bookworm
FIRMWARE_VALIDATION_REPORT_ROOT ?= $(REPO_ROOT)/build-validation
FIRMWARE_VALIDATE_ON_BUILD ?= $(if $(filter upstream,$(ARTEFACT_MODE)),1,0)
REPLAY_BOARD ?= O6
REPLAY_BOARD_LOWER = $(shell printf '%s' '$(REPLAY_BOARD)' | tr '[:upper:]' '[:lower:]')
REPLAY_DISTRO ?= bookworm
REPLAY_VERSION ?= $(FIRMWARE_VERSION)
REPLAY_PRODUCT ?= orion-$(REPLAY_BOARD_LOWER)
DETERMINISTIC_REPLAY_PROFILE ?= upstream-$(REPLAY_BOARD_LOWER)-$(REPLAY_VERSION)-$(REPLAY_DISTRO)
DETERMINISTIC_REPLAY_ROOT ?= $(REPO_ROOT)/.buildbox/replay/$(DETERMINISTIC_REPLAY_PROFILE)
DETERMINISTIC_REPLAY_IMAGE ?= $(if $(strip $(BUILDBOX_IMAGE)),$(BUILDBOX_IMAGE),mcr.microsoft.com/devcontainers/base:$(REPLAY_DISTRO))
DETERMINISTIC_REPLAY_MOUNT_ROOT ?= $(REPO_ROOT)/.buildbox
REPLAY_INPUT ?=
REPLAY_BUILD_OPTIONS ?=
REPLAY_BUILD_DATE ?=
FIRMWARE_SRC_BUILD_TARGETS = \
	Build/$(FIRMWARE_BOARD)/$(FIRMWARE_TARGET)/cix_flash_all.bin \
	Build/$(FIRMWARE_BOARD)/$(FIRMWARE_TARGET)/cix_flash_ota.bin
BUILDBOX_FIRMWARE_ARGS = \
	ARTEFACT_MODE="$(ARTEFACT_MODE)" \
	FIRMWARE_BOARD="$(FIRMWARE_BOARD)" \
	FIRMWARE_PRODUCT="$(FIRMWARE_PRODUCT)" \
	FIRMWARE_TARGET="$(FIRMWARE_TARGET)" \
	FIRMWARE_VERSION="$(FIRMWARE_VERSION)" \
	FIRMWARE_STAGE_ROOT="$(BUILDBOX_WORKSPACE_ROOT)/dist/firmware/$(FIRMWARE_PRODUCT)/$(FIRMWARE_VERSION)" \
	FIRMWARE_ARCHIVE_ROOT="$(BUILDBOX_WORKSPACE_ROOT)/dist" \
	FIRMWARE_VALIDATION_PROFILE="$(FIRMWARE_VALIDATION_PROFILE)" \
	FIRMWARE_VALIDATION_REPORT_ROOT="$(BUILDBOX_WORKSPACE_ROOT)/build-validation"

src/tools/gcc/gcc-arm-10.2-2020.11-x86_64-aarch64-none-elf.tar.xz:
	$(Q)mkdir -p src/tools/gcc
	$(Q)wget -O $@ \
	"https://developer.arm.com/-/media/files/downloads/gnu-a/10.2-2020.11/binrel/gcc-arm-10.2-2020.11-x86_64-aarch64-none-elf.tar.xz"

src/tools/gcc/%: src/tools/gcc/%.tar.xz
	$(Q)tar xvf $< -C src/tools/gcc/

build: build-edk2

.PHONY: help
help:
	@set -eu; \
	help_pad=40; \
	help_gap=2; \
	help_width=80; \
	desc_width=$$((help_width - help_pad - help_gap)); \
	print_help_line() { \
		label="$$1"; \
		desc="$$2"; \
		first_indent=$$(printf '%-*s%*s' "$$help_pad" "$$label" "$$help_gap" ''); \
		cont_indent=$$(printf '%*s' "$$((help_pad + help_gap))" ''); \
		printf '%s\n' "$$desc" | fold -s -w "$$desc_width" | \
			awk -v first="$$first_indent" -v cont="$$cont_indent" \
				'NR == 1 { print first $$0; next } { sub(/^ +/, "", $$0); print cont $$0 }'; \
	}; \
	printf '%s\n\n' 'edk2-cix common targets'; \
	print_help_line '  help' 'Show this help text'; \
	print_help_line '  firmware_build_dep' 'Install only the direct firmware-build host dependencies'; \
	print_help_line '  devcontainer_setup' 'Install host build dependencies'; \
	print_help_line '  build-edk2' 'Run the raw src/ firmware build'; \
	print_help_line '  firmware-build' 'Build the O6 firmware artefacts'; \
	print_help_line '  firmware-stage' 'Stage deployable firmware files under dist/firmware/'; \
	print_help_line '  install' 'Copy the staged payload under /boot/efi/firmware/radxa/'; \
	print_help_line '  zip' 'Create a .zip firmware archive'; \
	print_help_line '  targz' 'Create a .tar.gz firmware archive'; \
	print_help_line '  deb' 'Build the Debian package'; \
	print_help_line '  validate-firmware' 'Check outputs against the active validation profile'; \
	print_help_line '  validate-firmware-strict' 'Require exact matches from the validation profile'; \
	print_help_line '  capture-validation-profile' 'Snapshot the current build into a profile JSON'; \
	print_help_line '  deterministic-replay' 'Seed or reuse exact replay inputs, rebuild, and validate them strictly'; \
	print_help_line '  clean' 'Remove build output, packaging by-products, and buildbox state'; \
	printf '\n%s\n\n' 'buildbox targets'; \
	print_help_line '  buildbox-up' 'Start or reuse the persistent build container'; \
	print_help_line '  buildbox-down' 'Remove the persistent build container if it exists'; \
	print_help_line '  buildbox-metadata' 'Print resolved build metadata inside the buildbox'; \
	print_help_line '  buildbox-firmware-build' 'Build firmware inside the buildbox'; \
	print_help_line '  buildbox-firmware-stage' 'Stage deployable firmware on the host under dist/firmware/'; \
	print_help_line '  buildbox-o6' 'Compatibility alias for buildbox-firmware-build'; \
	print_help_line '  buildbox-o6-log' 'Capture a full logged buildbox firmware build'; \
	print_help_line '  buildbox-deb' 'Build the Debian package inside the buildbox'; \
	print_help_line '  buildbox-zip' 'Create a .zip archive inside the buildbox'; \
	print_help_line '  buildbox-targz' 'Create a .tar.gz archive inside the buildbox'; \
	print_help_line '  buildbox-validate-firmware' 'Run validation inside the buildbox'; \
	print_help_line '  buildbox-validate-firmware-strict' 'Run strict validation inside the buildbox'; \
	print_help_line '  buildbox-capture-validation-profile' 'Capture a validation profile inside the buildbox'; \
	printf '\n%s\n\n' 'useful variables'; \
	print_help_line '  ARTEFACT_MODE=custom|upstream' 'Select the custom or upstream output mode'; \
	print_help_line '  V=1' 'Show raw EDK2 command lines'; \
	print_help_line '  FIRMWARE_BOARD=O6' 'Select the firmware board'; \
	print_help_line '  FIRMWARE_VALIDATION_PROFILE=<name>' 'Override the validation profile'; \
	print_help_line '  REPLAY_BOARD=O6|O6N' 'Select the exact replay board (defaults to O6)'; \
	print_help_line '  REPLAY_DISTRO=bookworm|trixie' 'Select the exact replay distro family'; \
	print_help_line '  REPLAY_INPUT=/path/to/release' 'Seed cached replay inputs from a .deb, O6 dir, or cix_flash_all.bin'; \
	print_help_line '  BUILDBOX_PLATFORM=linux/amd64|linux/arm64' 'Force the buildbox container architecture'; \
	print_help_line '  BUILDBOX_IMAGE=<image>' 'Override the buildbox base image'; \
	printf '\n%s\n' 'For lower-level firmware targets, run: make -C src help'

.PHONY: build-edk2 __build-edk2
build-edk2:
	$(Q)$(LOCKED_MAKE) __build-edk2 V="$(V)"

__build-edk2:
	$(Q)$(MAKE) --no-print-directory -C "$(REPO_ROOT)/src" V="$(V)"

.PHONY: firmware-build __firmware-build
firmware-build:
	$(Q)$(LOCKED_MAKE) __firmware-build V="$(V)"

__firmware-build:
	$(Q)$(MAKE) --no-print-directory -C "$(REPO_ROOT)/src" V="$(V)" $(FIRMWARE_SRC_BUILD_TARGETS)
	@if [ "$(FIRMWARE_VALIDATE_ON_BUILD)" = "1" ]; then \
		printf '\n[validate] Checking artefacts against %s\n' "$(FIRMWARE_VALIDATION_PROFILE)"; \
		mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"; \
		python3 "$(REPO_ROOT)/scripts/validate_firmware_outputs.py" \
			--repo-root "$(REPO_ROOT)" \
			--board "$(FIRMWARE_BOARD)" \
			--target "$(FIRMWARE_TARGET)" \
			--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
		--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json"; \
	fi

.PHONY: firmware-stage __firmware-stage
firmware-stage:
	$(Q)$(LOCKED_MAKE) __firmware-stage V="$(V)"

__firmware-stage: __firmware-build
	$(Q)python3 "$(REPO_ROOT)/scripts/export_firmware_payload.py" stage \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(FIRMWARE_TARGET)" \
		--version "$(FIRMWARE_VERSION)" \
		--output-dir "$(FIRMWARE_STAGE_ROOT)"

.PHONY: install __install
install:
	$(Q)$(LOCKED_MAKE) __install V="$(V)"

__install: __firmware-stage
	$(Q)python3 "$(REPO_ROOT)/scripts/export_firmware_payload.py" install \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(FIRMWARE_TARGET)" \
		--version "$(FIRMWARE_VERSION)" \
		--install-root "$(FIRMWARE_INSTALL_ROOT)"

.PHONY: zip __zip
zip:
	$(Q)$(LOCKED_MAKE) __zip V="$(V)"

__zip: __firmware-build
	$(Q)python3 "$(REPO_ROOT)/scripts/export_firmware_payload.py" zip \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(FIRMWARE_TARGET)" \
		--version "$(FIRMWARE_VERSION)" \
		--output "$(FIRMWARE_ARCHIVE_ROOT)/$(FIRMWARE_ARCHIVE_BASENAME).zip"

.PHONY: targz __targz
targz:
	$(Q)$(LOCKED_MAKE) __targz V="$(V)"

__targz: __firmware-build
	$(Q)python3 "$(REPO_ROOT)/scripts/export_firmware_payload.py" targz \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--product "$(FIRMWARE_PRODUCT)" \
		--target "$(FIRMWARE_TARGET)" \
		--version "$(FIRMWARE_VERSION)" \
		--output "$(FIRMWARE_ARCHIVE_ROOT)/$(FIRMWARE_ARCHIVE_BASENAME).tar.gz"

.PHONY: validate-firmware __validate-firmware
validate-firmware:
	$(Q)$(LOCKED_MAKE) __validate-firmware V="$(V)"

__validate-firmware:
	@mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"
	$(Q)python3 "$(REPO_ROOT)/scripts/validate_firmware_outputs.py" \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--target "$(FIRMWARE_TARGET)" \
		--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
		--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json"

.PHONY: validate-firmware-strict __validate-firmware-strict
validate-firmware-strict:
	$(Q)$(LOCKED_MAKE) __validate-firmware-strict V="$(V)"

__validate-firmware-strict:
	@mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"
	$(Q)python3 "$(REPO_ROOT)/scripts/validate_firmware_outputs.py" \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--target "$(FIRMWARE_TARGET)" \
		--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
		--strict \
		--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json"

.PHONY: capture-validation-profile __capture-validation-profile
capture-validation-profile:
	$(Q)$(LOCKED_MAKE) __capture-validation-profile V="$(V)"

__capture-validation-profile:
	@mkdir -p "$(FIRMWARE_VALIDATION_REPORT_ROOT)"
	$(Q)python3 "$(REPO_ROOT)/scripts/validate_firmware_outputs.py" \
		--repo-root "$(REPO_ROOT)" \
		--board "$(FIRMWARE_BOARD)" \
		--target "$(FIRMWARE_TARGET)" \
		--profile "$(FIRMWARE_VALIDATION_PROFILE)" \
		--report-json "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(FIRMWARE_TARGET)-$(FIRMWARE_VALIDATION_PROFILE).json" \
		--emit-profile "$(FIRMWARE_VALIDATION_REPORT_ROOT)/$(FIRMWARE_BOARD)-$(FIRMWARE_TARGET)-profile.json" \
		--emit-profile-name "$(FIRMWARE_VALIDATION_PROFILE)"

.PHONY: deterministic-replay __deterministic-replay
deterministic-replay:
	$(Q)$(LOCKED_MAKE) __deterministic-replay V="$(V)"

__deterministic-replay:
	@set -euo pipefail; \
	replay_board="$(REPLAY_BOARD)"; \
	replay_dir="$(DETERMINISTIC_REPLAY_ROOT)"; \
	replay_input='$(strip $(REPLAY_INPUT))'; \
	replay_build_options='$(strip $(REPLAY_BUILD_OPTIONS))'; \
	replay_build_date='$(strip $(REPLAY_BUILD_DATE))'; \
	validation_file="$(REPO_ROOT)/validation/$(REPLAY_BOARD_LOWER)/expected-hashes.json"; \
	if [ ! -f "$$validation_file" ]; then \
		echo "[replay] No checked-in exact replay validation data exists for board $$replay_board." >&2; \
		echo "[replay] Expected: $$validation_file" >&2; \
		exit 2; \
	fi; \
	if [ -n "$$replay_input" ]; then \
		if [ "$$replay_board" != "O6" ]; then \
			echo "[replay] Automatic replay input extraction is currently implemented only for O6." >&2; \
			echo "[replay] For $$replay_board, pre-populate $$replay_dir with replay.env and certs/ first." >&2; \
			exit 2; \
		fi; \
		printf '[replay] Extracting exact replay inputs into %s\n' "$$replay_dir"; \
		rm -rf "$$replay_dir"; \
		mkdir -p "$$replay_dir"; \
		replay_cmd=(python3 "$(REPO_ROOT)/src/scripts/replay_o6_release.py" "$$replay_input" --output-dir "$$replay_dir"); \
		if [ -n "$$replay_build_options" ]; then \
			replay_cmd+=(--build-options "$$replay_build_options"); \
		fi; \
		if [ -n "$$replay_build_date" ]; then \
			replay_cmd+=(--build-date "$$replay_build_date"); \
		fi; \
		"$${replay_cmd[@]}"; \
	elif [ ! -f "$$replay_dir/replay.env" ]; then \
		echo "[replay] No cached replay inputs found at $$replay_dir/replay.env" >&2; \
		echo "[replay] Re-run with REPLAY_INPUT=/path/to/edk2-cix_*.deb" >&2; \
		echo "[replay] or REPLAY_INPUT=/path/to/cix_flash_all.bin plus REPLAY_BUILD_OPTIONS=/path/to/BuildOptions." >&2; \
		exit 2; \
	else \
		printf '[replay] Reusing cached replay inputs from %s\n' "$$replay_dir"; \
	fi; \
	if [ ! -f "$$replay_dir/replay.env" ]; then \
		echo "[replay] Expected $$replay_dir/replay.env after preparing replay inputs." >&2; \
		exit 2; \
	fi; \
	set -a; . "$$replay_dir/replay.env"; set +a; \
	replay_mount_root="$(DETERMINISTIC_REPLAY_MOUNT_ROOT)"; \
	replay_cert_dir_host="$$SIGNING_CERT_SOURCE_DIR"; \
	case "$$replay_cert_dir_host" in \
		"$$replay_mount_root"/*) \
			replay_cert_dir_container="/hosttmp/$${replay_cert_dir_host#$$replay_mount_root/}"; \
			;; \
		*) \
			echo "[replay] Cached cert bundle $$replay_cert_dir_host is outside $$replay_mount_root and cannot be mounted into the buildbox." >&2; \
			echo "[replay] Move the replay cache under $$replay_mount_root or override DETERMINISTIC_REPLAY_MOUNT_ROOT accordingly." >&2; \
			exit 2; \
			;; \
	esac; \
	printf '[replay] Running %s in %s using %s\n' "$(DETERMINISTIC_REPLAY_PROFILE)" "$(REPLAY_DISTRO)" "$(DETERMINISTIC_REPLAY_IMAGE)"; \
	$(BUILDBOX_ENV) EDK2_CIX_HOST_TMPDIR="$$replay_mount_root" EDK2_CIX_CONTAINER_TMPDIR="/hosttmp" EDK2_CIX_BUILDBOX_IMAGE="$(DETERMINISTIC_REPLAY_IMAGE)" \
		"$(REPO_ROOT)/scripts/run_in_buildbox.sh" \
		make --no-print-directory -C src clean V="$(V)"; \
	$(BUILDBOX_ENV) EDK2_CIX_HOST_TMPDIR="$$replay_mount_root" EDK2_CIX_CONTAINER_TMPDIR="/hosttmp" EDK2_CIX_BUILDBOX_IMAGE="$(DETERMINISTIC_REPLAY_IMAGE)" \
		"$(REPO_ROOT)/scripts/run_in_buildbox.sh" \
		make --no-print-directory firmware-build V="$(V)" \
		ARTEFACT_MODE="upstream" \
		FIRMWARE_BOARD="$(REPLAY_BOARD)" \
		FIRMWARE_PRODUCT="$(REPLAY_PRODUCT)" \
		FIRMWARE_TARGET="$(FIRMWARE_TARGET)" \
		FIRMWARE_VERSION="$(REPLAY_VERSION)" \
		FIRMWARE_VALIDATION_PROFILE="$(DETERMINISTIC_REPLAY_PROFILE)" \
		BUILD_DATE="$$BUILD_DATE" \
		SOURCE_DATE_EPOCH="$$SOURCE_DATE_EPOCH" \
		PM_CONFIG_SOURCE_DATE_EPOCH="$$PM_CONFIG_SOURCE_DATE_EPOCH" \
		SIGNING_CERT_SOURCE_DIR="$$replay_cert_dir_container" \
		SOURCE_COMMIT_HASH="$${SOURCE_COMMIT_HASH:-}" \
		EDK2_COMMIT_HASH="$${EDK2_COMMIT_HASH:-}" \
		EDK2_NON_OSI_COMMIT_HASH="$${EDK2_NON_OSI_COMMIT_HASH:-}" \
		EDK2_PLATFORMS_COMMIT_HASH="$${EDK2_PLATFORMS_COMMIT_HASH:-}"; \
	$(BUILDBOX_ENV) EDK2_CIX_HOST_TMPDIR="$$replay_mount_root" EDK2_CIX_CONTAINER_TMPDIR="/hosttmp" EDK2_CIX_BUILDBOX_IMAGE="$(DETERMINISTIC_REPLAY_IMAGE)" \
		"$(REPO_ROOT)/scripts/run_in_buildbox.sh" \
		make --no-print-directory validate-firmware-strict V="$(V)" \
		FIRMWARE_BOARD="$(REPLAY_BOARD)" \
		FIRMWARE_PRODUCT="$(REPLAY_PRODUCT)" \
		FIRMWARE_TARGET="$(FIRMWARE_TARGET)" \
		FIRMWARE_VERSION="$(REPLAY_VERSION)" \
		FIRMWARE_VALIDATION_PROFILE="$(DETERMINISTIC_REPLAY_PROFILE)"

.PHONY: clean __clean
clean:
	$(Q)$(LOCKED_MAKE) __clean V="$(V)"

__clean: __clean-edk2 __clean-buildbox

.PHONY: clean-edk2 __clean-edk2
clean-edk2:
	$(Q)$(LOCKED_MAKE) __clean-edk2 V="$(V)"

__clean-edk2:
	$(Q)$(MAKE) --no-print-directory -C "$(REPO_ROOT)/src" V="$(V)" clean

.PHONY: buildbox-down __buildbox-down
buildbox-down:
	$(Q)$(LOCKED_MAKE) __buildbox-down V="$(V)"

__buildbox-down:
	@container_name="$${EDK2_CIX_BUILDBOX_NAME:-edk2-cix-buildbox}"; \
	requested_runtime="$${EDK2_CIX_CONTAINER_RUNTIME:-}"; \
	host_os="$$(uname -s 2>/dev/null || echo unknown)"; \
	removed=0; \
	found_runtime=0; \
	if [ -n "$$requested_runtime" ]; then \
		runtimes="$$requested_runtime podman docker"; \
	elif [ "$$host_os" = "Darwin" ]; then \
		runtimes="docker podman"; \
	else \
		runtimes="podman docker"; \
	fi; \
	for runtime in $$runtimes; do \
		command -v "$$runtime" >/dev/null 2>&1 || continue; \
		found_runtime=1; \
		if "$$runtime" container inspect "$$container_name" >/dev/null 2>&1; then \
			printf '[clean] Removing buildbox container %s via %s\n' "$$container_name" "$$runtime"; \
			"$$runtime" rm -f "$$container_name" >/dev/null; \
			removed=1; \
			break; \
		fi; \
	done; \
	if [ "$$removed" -eq 0 ]; then \
		if [ "$$found_runtime" -eq 0 ]; then \
			printf '%s\n' '[clean] No container runtime available; skipping buildbox cleanup'; \
		else \
			printf '%s\n' '[clean] No buildbox container to remove'; \
		fi; \
	fi

.PHONY: clean-buildbox __clean-buildbox
clean-buildbox:
	$(Q)$(LOCKED_MAKE) __clean-buildbox V="$(V)"

__clean-buildbox: __buildbox-down
	@if [ -d "$(BUILDBOX_HOST_TMPDIR)" ]; then \
		printf '[clean] Removing buildbox scratch %s\n' "$(BUILDBOX_HOST_TMPDIR)"; \
		rm -rf "$(BUILDBOX_HOST_TMPDIR)"; \
	fi

.PHONY: buildbox-up __buildbox-up
buildbox-up:
	$(Q)$(LOCKED_MAKE) __buildbox-up V="$(V)"

__buildbox-up:
	$(Q)$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" true

.PHONY: buildbox-deb __buildbox-deb
buildbox-deb:
	$(Q)$(LOCKED_MAKE) __buildbox-deb V="$(V)"

__buildbox-deb:
	$(Q)$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" --dep-profile packaging \
		bash -lc 'set -euo pipefail; repo_root="$$(pwd -P)"; parent_dir="$$(dirname "$$repo_root")"; output_dir="$(BUILDBOX_DEB_RESULT_ROOT_IN_CONTAINER)"; package_name="$$(dpkg-parsechangelog -S Source)"; mkdir -p "$$output_dir"; make --no-print-directory deb; find "$$parent_dir" -maxdepth 1 -type f \( -name "$$package_name"_*.deb -o -name "$$package_name"_*.udeb -o -name "$$package_name"_*.changes -o -name "$$package_name"_*.buildinfo -o -name "$$package_name"_*.build \) -exec cp -f -t "$$output_dir" {} +'

.PHONY: buildbox-firmware-build __buildbox-firmware-build
buildbox-firmware-build:
	$(Q)$(LOCKED_MAKE) __buildbox-firmware-build V="$(V)"

__buildbox-firmware-build:
	$(Q)$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/run_in_buildbox.sh" make --no-print-directory firmware-build V="$(V)" \
		$(BUILDBOX_FIRMWARE_ARGS)

.PHONY: buildbox-o6
buildbox-o6: buildbox-firmware-build

.PHONY: buildbox-o6-log __buildbox-o6-log
buildbox-o6-log:
	$(Q)$(LOCKED_MAKE) __buildbox-o6-log V="$(V)"

__buildbox-o6-log:
	$(Q)$(BUILDBOX_ENV) "$(REPO_ROOT)/scripts/capture_build_log.sh" "$(BUILD_LOG_ROOT)" \
		"$(REPO_ROOT)/scripts/run_in_buildbox.sh" \
		make --no-print-directory firmware-build V="$(V)" $(BUILDBOX_FIRMWARE_ARGS)

