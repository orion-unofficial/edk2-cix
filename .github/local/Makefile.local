	fi; \
	if [ -n "$(strip $(ACT_SECRET_FILE))" ]; then \
		args+=(--secret-file "$(strip $(ACT_SECRET_FILE))"); \
	fi; \
	if [ -n "$(strip $(ACT_EXTRA_ARGS))" ]; then \
		extra_args=( $(ACT_EXTRA_ARGS) ); \
		args+=("$${extra_args[@]}"); \
	fi; \
	"$(REPO_ROOT)/scripts/run_github_actions_with_act.sh" "$${args[@]}"

.PHONY: gha-act-run-clean __gha-act-run-clean
gha-act-run-clean:
