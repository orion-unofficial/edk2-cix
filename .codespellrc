[codespell]
# Keep this to the unambiguous dictionary. The default also includes "rare",
# which is very noisy for firmware acronyms, register names, and generated code.
builtin = clear
quiet-level = 3

# codespell has path-based skip rules rather than a generic "do not follow
# symlinks" switch. The explicit custom/overlay paths below are tracked
# symlinks to mirrored sources; X11IncludeHack points outside the repository.
skip =
    *.bin,
    *.bmp,
    *.bsf,
    *.compressed,
    *.depex,
    *.der,
    *.efi,
    *.gif,
    *.ico,
    *.jpeg,
    *.jpg,
    *.pdf,
    *.png,
    *.ps,
    *.raw,
    *.rtf,
    *.wav,
    */Dictionary.cs,
    */DictionaryData.java,
    */UnicodeData.txt,
    */decode.js,
    */decode.min.js,
    */dictionary.bin,
    */fuzz/cert_corpus/*,
    */fuzz/corpora/*,
    */htmlhelp/*,
    */obj_dat.h,
    */obj_mac.h,
    */objects.txt,
    */po/*.po,
    */Pccts/*,
    */test/d2i-tests/*,
    */test/recipes/*,
    */test/suites/*,
    */testdata/*,
    */tests/testdata/*,
    *MinnowBoardMAXUEFIFirmware-LicenseAgreement-Final.txt,
    *custom/overlay/edk2-platforms/Platform/Radxa/Orion/O6/Drivers/PlatformSmbios/PlatformSmbios.c,
    *custom/overlay/edk2-platforms/Platform/Radxa/Orion/O6/Drivers/PlatformSmbios/PlatformSmbios.h,
    *custom/overlay/edk2-platforms/Platform/Radxa/Orion/O6/Drivers/PlatformSmbios/SmbiosType0.c,
    *custom/overlay/edk2-platforms/Platform/Radxa/Orion/O6/Drivers/PlatformSmbios/SmbiosType32.c,
    *custom/overlay/edk2-platforms/Platform/Radxa/Orion/O6/Drivers/PlatformSmbios/SmbiosType4.c,
    *custom/overlay/edk2-platforms/Platform/Radxa/Orion/O6/Drivers/PlatformSmbios/SmbiosType7.c,
    *custom/overlay/edk2-platforms/Platform/Radxa/Platforms/CIX/Sky1/Drivers/SystemInfoDxe/SystemInfoDxe.h,
    *custom/overlay/edk2-platforms/Platform/Radxa/Platforms/CIX/Sky1/Drivers/SystemInfoDxe/SystemInfoDxe.inf,
    *custom/overlay/edk2-platforms/Platform/Radxa/Platforms/CIX/Sky1/Drivers/SystemInfoDxe/SystemInfoHii.h,
    *custom/overlay/edk2-platforms/Platform/Radxa/Platforms/CIX/Sky1/Drivers/SystemInfoDxe/SystemInfoHii.vfr,
    *src/edk2/EmulatorPkg/Unix/Host/X11IncludeHack*,
    src/edk2-non-osi/Silicon/AMD/VanGogh/ReleaseNote.txt

ignore-words-list =
    AER,
    AFE,
    Alo,
    ALS,
    Afe,
    BufferIn,
    BufferOut,
    FileTest,
    Fo,
    GOST,
    HDA,
    HSI,
    HTE,
    INOUT,
    IST,
    MOR,
    NextED,
    PARM,
    SHS,
    Synopsys,
    TE,
    adin,
    alo,
    als,
    ciph,
    clen,
    fo,
    hda,
    hsi,
    inout,
    larg,
    nd,
    parm,
    parms,
    passin,
    ser,
    siz,
    te,
    tolen
