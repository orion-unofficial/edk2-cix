#string STR_I2C7_BUS_FREQ_PROMPT              #language en-US "Bus Speed"
#string STR_I2C0_BUS_FREQ_HELP                #language en-US "Select the I2C0 bus speed. Default: 100 kHz. Not every attached device supports every rate."
#string STR_I2C1_BUS_FREQ_HELP                #language en-US "Select the I2C1 bus speed. Default: 100 kHz. Not every attached device supports every rate."
#string STR_I2C2_BUS_FREQ_HELP                #language en-US "Select the I2C2 bus speed. Default: 100 kHz. Not every attached device supports every rate."
#string STR_I2C3_BUS_FREQ_HELP                #language en-US "Select the I2C3 bus speed. Default: 100 kHz. Not every attached device supports every rate."
#string STR_I2C4_BUS_FREQ_HELP                #language en-US "Select the I2C4 bus speed. Default: 100 kHz. Not every attached device supports every rate."
#string STR_I2C5_BUS_FREQ_HELP                #language en-US "Select the I2C5 bus speed. Default: 100 kHz. Not every attached device supports every rate."
#string STR_I2C6_BUS_FREQ_HELP                #language en-US "Select the I2C6 bus speed. Default: O6 50 kHz; O6N 100 kHz. Not every attached device supports every rate."
#string STR_I2C7_BUS_FREQ_HELP                #language en-US "Select the I2C7 bus speed. Default: 100 kHz. Not every attached device supports every rate."

