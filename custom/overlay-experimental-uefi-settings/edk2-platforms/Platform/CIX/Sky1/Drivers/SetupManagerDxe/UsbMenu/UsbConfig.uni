#langdef en-US  "English"
/*
* USB settings.
*/
#string STR_USB_FORM_SET_TITLE                #language en-US "USB Configuration"
#string STR_USB_FORM_SET_TITLE_HELP           #language en-US "Configure USB controllers and roles. Defaults are shown in each item help."
#string STR_USB_DEVICE_MODEL_PROMPT           #language en-US "USB Device Model"
#string STR_USB_DEVICE_MODEL_HELP             #language en-US "Choose which ACPI USB device model firmware exposes to the OS. Linux exposes standard PNP0D10 controllers and is the safest default for upstream kernels. CIX exposes CIXH2030/CIXH2031 USB devices for kernels that use the vendor CIX USB stack. Default: Linux (PNP0D10)."
#string STR_USB_DEVICE_MODEL_LINUX            #language en-US "Linux (PNP0D10)"
#string STR_USB_DEVICE_MODEL_CIX              #language en-US "CIX (CIXH2030/CIXH2031)"
#string STR_USB_DEVICE_MODEL_NOTE             #language en-US "Linux can show separate USB2 and USB3 root hubs for a single SuperSpeed controller."
#string STR_USB_GENERIC_XHCI_PROMPT0          #language en-US "Linux xHCI visibility: documented USB-C port (USBC0)"
#string STR_USB_GENERIC_XHCI_PROMPT1          #language en-US "Linux xHCI visibility: non-default Type-C path (USBC1)"
#string STR_USB_GENERIC_XHCI_PROMPT2          #language en-US "Linux xHCI visibility: additional Type-C path (USBC2)"
#string STR_USB_GENERIC_XHCI_PROMPT3          #language en-US "Linux xHCI visibility: display/front USB2 path (USBC3)"
#string STR_USB_GENERIC_XHCI_HELP0            #language en-US "Controls whether firmware exposes the generic Linux PNP0D10/xHCI ACPI device for USBC0. Radxa documents a user-facing rear USB Type-C port here; on O6 the docs say USBC0 supports OTG mode, and on O6N the single documented USB Type-C port is the DP-capable rear Type-C connector. Default: enabled on O6 and O6N. This setting only affects USB Device Model = Linux (PNP0D10)."
#string STR_USB_GENERIC_XHCI_HELP1            #language en-US "Controls whether firmware exposes the generic Linux PNP0D10/xHCI ACPI device for USBC1. Radxa documents a second rear USB Type-C port on O6, but current firmware board policy does not treat this path as a default generic Linux xHCI device; O6N board comments instead associate it with HDMI and the M.2 B key path. Default: disabled on O6 and O6N. This setting only affects USB Device Model = Linux (PNP0D10)."
#string STR_USB_GENERIC_XHCI_HELP2            #language en-US "Controls whether firmware exposes the generic Linux PNP0D10/xHCI ACPI device for USBC2. Current O6 firmware board policy uses this as the second default generic rear USB Type-C data path, while current O6N policy hides it because platform comments associate it with USB/UFS rather than the single documented rear USB Type-C connector. Default: enabled on O6; disabled on O6N. This setting only affects USB Device Model = Linux (PNP0D10)."
#string STR_USB_GENERIC_XHCI_HELP3            #language en-US "Controls whether firmware exposes the generic Linux PNP0D10/xHCI ACPI device for USBC3. Current firmware board policy does not expose this path by default; O6 comments describe a display-oriented high-speed-only path, and O6N comments associate it with DisplayPort and front-panel USB2. Default: disabled on O6 and O6N. This setting only affects USB Device Model = Linux (PNP0D10)."

#string STR_USB2_CONTROL_PROMPT0              #language en-US "USB2 Controller 0"
#string STR_USB2_CONTROL_PROMPT1              #language en-US "USB2 Controller 1"
#string STR_USB2_CONTROL_PROMPT2              #language en-US "USB2 Controller 2"
#string STR_USB2_CONTROL_PROMPT3              #language en-US "USB2 Controller 3"
#string STR_USB3_CONTROL_PROMPT0              #language en-US "USB3 Controller 0"
#string STR_USB3_CONTROL_PROMPT1              #language en-US "USB3 Controller 1"
#string STR_USBC_DRD_CONTROL_PROMPT           #language en-US "USB-C DRD Controller"
#string STR_USBC_CONTROL_PROMPT0              #language en-US "USB-C Controller 0"
#string STR_USBC_CONTROL_PROMPT1              #language en-US "USB-C Controller 1"
#string STR_USBC_CONTROL_PROMPT2              #language en-US "USB-C Controller 2"
#string STR_USBC_DRD_DATA_ROLE_PROMPT         #language en-US "USB-C DRD Role"

#string STR_USB2_CONTROL_HELP                 #language en-US "Enable or disable this USB 2.0 controller. Default: enabled on O6 and O6N."
#string STR_USB3_CONTROL_HELP                 #language en-US "Enable or disable this USB 3.2 controller. Default: enabled on O6 and O6N."
#string STR_USBC_CONTROL_HELP                 #language en-US "Enable or disable this USB-C controller. Default: enabled on O6 and O6N."
#string STR_USBC_DRD_CONTROL_HELP             #language en-US "Enable or disable this USB-C dual-role controller. Default: enabled on O6 and O6N."
#string STR_USB_DATA_ROLE_HELP                #language en-US "Select whether the USB-C dual-role controller starts in host or device mode. Default: Host."
#string STR_USB_DATA_ROLE_HOST                #language en-US "Host"
#string STR_USB_DATA_ROLE_DEVICE              #language en-US "Device"
