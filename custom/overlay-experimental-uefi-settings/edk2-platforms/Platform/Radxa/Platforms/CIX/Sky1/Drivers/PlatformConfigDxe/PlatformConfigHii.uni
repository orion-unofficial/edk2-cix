#langdef en-US  "English"

#string STR_FORM_SET_TITLE               #language en-US "Platform Configuration"
#string STR_FORM_SET_TITLE_HELP          #language en-US "Press <Enter> to configure platform settings."

#string STR_MAIN_FORM_TITLE              #language en-US "Platform Configuration"
#string STR_EMPTY_STRING                 #language en-US ""
#string STR_EXIT_STRING                  #language en-US "Press ESC to exit."

#string STR_ENABLED                      #language en-US "Enabled"
#string STR_DISABLED                     #language en-US "Disabled"

#string STR_ACPI_FEATURE_STRING          #language en-US "* Some features are disabled due to\n"
                                                         "  current system configuration."
#string STR_ACPI_FEATURE_HELP            #language en-US "Use ACPI as the OS hardware description to reveal hidden options."

#string STR_ADVANCED_FORM_SET_TITLE      #language en-US "Advanced Configuration"
#string STR_ADVANCED_FORM_SET_TITLE_HELP #language en-US "Changing these settings may prevent the system from booting."
#string STR_ADVANCED_FORM_SET_RECOVERY   #language en-US "Have a hardware recovery tool ready before changing these settings."

#string STR_NETWORK_STACK_PROMPT         #language en-US "Network Stack"
#string STR_NETWORK_STACK_PROMPT_HELP    #language en-US "Enable or disable the firmware network stack in UEFI for PXE and HTTP boot. Default: disabled."
#string STR_IPV4_PXE_BOOT_PROMPT         #language en-US "IPv4 PXE Boot"
#string STR_IPV4_PXE_BOOT_PROMPT_HELP    #language en-US "Enable or disable IPv4 PXE boot in UEFI. Default: enabled when the network stack is enabled."
#string STR_IPV6_PXE_BOOT_PROMPT         #language en-US "IPv6 PXE Boot"
#string STR_IPV6_PXE_BOOT_PROMPT_HELP    #language en-US "Enable or disable IPv6 PXE boot in UEFI. Default: enabled when the network stack is enabled."
#string STR_IPV4_HTTP_BOOT_PROMPT        #language en-US "IPv4 HTTP Boot"
#string STR_IPV4_HTTP_BOOT_PROMPT_HELP   #language en-US "Enable or disable IPv4 HTTP boot in UEFI. Default: enabled when the network stack is enabled."
#string STR_IPV6_HTTP_BOOT_PROMPT        #language en-US "IPv6 HTTP Boot"
#string STR_IPV6_HTTP_BOOT_PROMPT_HELP   #language en-US "Enable or disable IPv6 HTTP boot in UEFI. Default: enabled when the network stack is enabled."

#string STR_STATE_AFTER_G3               #language en-US "Restore AC Power Loss"
#string STR_STATE_AFTER_G3_HELP          #language en-US "Select AC power state when power is re-applied after a power failure. Default: Power On."
#string STR_S0_AFTER_G3_STRING           #language en-US "Power On"
#string STR_S5_AFTER_G3_STRING           #language en-US "Power Off"
#string STR_LASTSTATE_AFTER_G3_STRING    #language en-US "Last State"

#string STR_EC_FAN_MODE_PROMPT           #language en-US "EC Fan Mode"
#string STR_EC_FAN_MODE_PROMPT_HELP      #language en-US "Select the default EC fan mode. Default: Auto Mode."
#string STR_AUTO_MODE                    #language en-US "Auto Mode"
#string STR_PERF_MODE                    #language en-US "Performance Mode"
#string STR_MUTE_MODE                    #language en-US "Silent Mode"

#string STR_UFS_POWER_MODE_PROMPT        #language en-US "UFS Power Mode"
#string STR_UFS_POWER_MODE_PROMPT_HELP   #language en-US "Choose the default UFS power policy. Default: Auto Mode when this option is shown.\n\n"
                                                         "<Auto Mode> enables the UFS bridge only when a module is detected during boot.\n\n"
                                                         "<Always On> keeps the bridge powered even when no module is attached; the OS may show a zero-sized block device.\n\n"
                                                         "<Always Off> keeps the bridge powered off."
#string STR_UFS_POWER_AUTO               #language en-US "Auto Mode"
#string STR_UFS_POWER_ALWAYS_ON          #language en-US "Always On"
#string STR_UFS_POWER_ALWAYS_OFF         #language en-US "Always Off"
