{
  "checks": [
    {
      "description": "Upstream EDK2 source",
      "id": "edk2",
      "local": {
        "type": "edk2-release"
      },
      "remote": "edk2",
      "release": {
        "description": "Latest upstream EDK2 stable release tag",
        "mode": "strict",
        "tag_pattern": "^refs/tags/edk2-stable(?P<version>\\d{6}(?:\\.\\d+)?)$"
      },
      "commits": {
        "description": "Upstream EDK2 master branch head",
        "mode": "advisory",
        "ref": "refs/heads/master"
      }
    },
    {
      "description": "Radxa edk2-cix source",
      "id": "radxa",
      "remote": "radxa-edk2-cix",
      "release": {
        "description": "Latest Radxa edk2-cix release tag",
        "local": {
          "compare_object": false,
          "type": "radxa-release"
        },
        "mode": "strict",
        "tag_pattern": "^refs/tags/(?P<version>\\d+\\.\\d+\\.\\d+(?:-\\d+)?)$"
      },
      "commits": {
        "description": "Radxa edk2-cix main branch head",
        "local": {
          "type": "radxa-vendor-upstream-ref"
        },
        "mode": "advisory",
        "ref": "refs/heads/main"
      }
    },
    {
      "description": "CIX bios release bundle",
      "id": "cix-bios",
      "local": {
        "component": "bios",
        "type": "cix-component-ref"
      },
      "remote": "cix-bios",
      "release": {
        "description": "Latest CIX bios community release commit",
        "kind": "release_subject",
        "mode": "advisory",
        "ref": "refs/heads/cix_p1_community_dev",
        "scan_depth": 64,
        "subject_pattern": "^CIX P1 BIOS Community V(?P<version>\\d+(?:\\.\\d+)*) base on O6 Ecosystem Board$"
      },
      "commits": {
        "description": "CIX bios development branch head",
        "mode": "strict",
        "ref": "refs/heads/cix_p1_community_dev"
      }
    },
    {
      "description": "CIX bootloader1 release payload",
      "id": "cix-bootloader1",
      "local": {
        "component": "bootloader1",
        "type": "cix-component-ref"
      },
      "remote": "cix-edk2-non-osi-release",
      "release": {
        "description": "Latest CIX bootloader1 release commit",
        "kind": "release_subject",
        "mode": "advisory",
        "ref": "refs/heads/cix_p1_dev",
        "scan_depth": 128,
        "subject_pattern": "^(?:CIX )?P1 GA .*(?: \\[COMMUNITY\\])? RELEASE$"
      }
    },
    {
      "description": "Arm TF-A source",
      "id": "arm-tf-a",
      "local": {
        "component": "tf-a",
        "type": "arm-base-release"
      },
      "remote": "arm-tf-a",
      "release": {
        "description": "Latest Arm TF-A release tag",
        "mode": "advisory",
        "tag_pattern": "^refs/tags/v(?P<version>\\d+\\.\\d+(?:\\.\\d+)?)$"
      },
      "commits": {
        "description": "Arm TF-A master branch head",
        "mode": "advisory",
        "ref": "refs/heads/master"
      }
    },
    {
      "description": "OP-TEE OS source",
      "id": "arm-op-tee",
      "local": {
        "component": "op-tee",
        "type": "arm-base-release"
      },
      "remote": "arm-op-tee",
      "release": {
        "description": "Latest OP-TEE OS release tag",
        "mode": "advisory",
        "tag_pattern": "^refs/tags/(?P<version>\\d+\\.\\d+\\.\\d+)$"
      },
      "commits": {
        "description": "OP-TEE OS master branch head",
        "mode": "advisory",
        "ref": "refs/heads/master"
      }
    },
    {
      "description": "Microsoft Secure Boot object source",
      "id": "microsoft-secureboot",
      "local": {
        "field": "source_tag",
        "manifest_path": "custom/overlay/edk2-platforms/Platform/Radxa/Platforms/CIX/Sky1/SecureBootDefaults/Microsoft/manifest.lock.json",
        "object_field": "source_commit",
        "ref": "unofficial-default-current",
        "type": "json-field"
      },
      "remote": "microsoft-secureboot",
      "release": {
        "description": "Latest Microsoft Secure Boot object release tag",
        "mode": "strict",
        "tag_pattern": "^refs/tags/v(?P<version>\\d+\\.\\d+\\.\\d+)$"
      },
      "commits": {
        "description": "Microsoft Secure Boot object main branch head",
        "mode": "advisory",
        "ref": "refs/heads/main"
      }
    },
    {
      "description": "Local act runner tool",
      "id": "nektos-act",
      "local": {
        "label_template": "v{version}",
        "path": "scripts/ensure_act.sh",
        "pattern": "^act_version=\"\\$\\{EDK2_CIX_ACT_VERSION:-(?P<version>\\d+\\.\\d+\\.\\d+)\\}\"$",
        "type": "file-regex"
      },
      "remote": "nektos-act",
      "release": {
        "description": "Latest act release tag",
        "mode": "advisory",
        "tag_pattern": "^refs/tags/v(?P<version>\\d+\\.\\d+\\.\\d+)$"
      }
    },
    {
      "description": "GitHub Actions checkout action",
      "id": "github-actions-checkout",
      "local": {
        "action": "actions/checkout",
        "type": "workflow-action-ref"
      },
      "remote": "github-actions-checkout",
      "release": {
        "description": "Latest actions/checkout major release tag",
        "mode": "advisory",
        "tag_pattern": "^refs/tags/v(?P<version>\\d+)$"
      }
    },
    {
      "description": "GitHub Actions upload-artifact action",
      "id": "github-actions-upload-artifact",
      "local": {
        "action": "actions/upload-artifact",
        "type": "workflow-action-ref"
      },
      "remote": "github-actions-upload-artifact",
      "release": {
        "description": "Latest actions/upload-artifact major release tag",
        "mode": "advisory",
        "tag_pattern": "^refs/tags/v(?P<version>\\d+)$"
      }
    },
    {
      "description": "GitHub Actions configure-pages action",
      "id": "github-actions-configure-pages",
      "local": {
        "action": "actions/configure-pages",
        "type": "workflow-action-ref"
      },
      "remote": "github-actions-configure-pages",
      "release": {
        "description": "Latest actions/configure-pages major release tag",
        "mode": "advisory",
        "tag_pattern": "^refs/tags/v(?P<version>\\d+)$"
      }
    },
    {
      "description": "GitHub Actions deploy-pages action",
      "id": "github-actions-deploy-pages",
      "local": {
        "action": "actions/deploy-pages",
        "type": "workflow-action-ref"
      },
      "remote": "github-actions-deploy-pages",
      "release": {
        "description": "Latest actions/deploy-pages major release tag",
        "mode": "advisory",
        "tag_pattern": "^refs/tags/v(?P<version>\\d+)$"
      }
    },
    {
      "description": "Cachix install-nix-action",
      "id": "cachix-install-nix-action",
      "local": {
        "action": "cachix/install-nix-action",
        "type": "workflow-action-ref"
      },
      "remote": "cachix-install-nix-action",
      "release": {
        "description": "Latest cachix/install-nix-action major release tag",
        "mode": "advisory",
        "tag_pattern": "^refs/tags/v(?P<version>\\d+)$"
      }
    },
    {
      "description": "Cachix cachix-action",
      "id": "cachix-cachix-action",
      "local": {
        "action": "cachix/cachix-action",
        "type": "workflow-action-ref"
      },
      "remote": "cachix-cachix-action",
      "release": {
        "description": "Latest cachix/cachix-action major release tag",
        "mode": "advisory",
        "tag_pattern": "^refs/tags/v(?P<version>\\d+)$"
      }
    },
    {
      "description": "Docker setup-qemu-action",
      "id": "github-docker-setup-qemu-action",
      "local": {
        "action": "docker/setup-qemu-action",
        "type": "workflow-action-ref"
      },
      "remote": "github-docker-setup-qemu-action",
      "release": {
        "description": "Latest docker/setup-qemu-action major release tag",
        "mode": "advisory",
        "tag_pattern": "^refs/tags/v(?P<version>\\d+)$"
      }
    },
    {
      "description": "Local act runner container image",
      "id": "ghcr-catthehacker-ubuntu",
      "local": {
        "label_template": "{repository}:{version}",
        "path": "scripts/run_github_actions_with_act.sh",
        "pattern": "default_runner_image=\"\\$\\{ACT_RUNNER_IMAGE:-\\$\\{EDK2_CIX_ACT_RUNNER_IMAGE:-(?P<repository>ghcr\\.io/catthehacker/ubuntu):(?P<version>act-24\\.04-\\d{8})\\}\\}\"",
        "type": "file-regex"
      },
      "remote": "ghcr-catthehacker-ubuntu",
      "release": {
        "description": "Latest ghcr.io/catthehacker/ubuntu act 24.04 image tag",
        "kind": "docker_latest_tag",
        "mode": "advisory",
        "tag_name_filter": "act-24.04-",
        "tag_pattern": "^(?P<version>act-24\\.04-\\d{8})$"
      }
    },
    {
      "description": "Docs workflow Nix base image",
      "id": "nixos-nix",
      "local": {
        "path": "docs/scripts/docs-workflow.Dockerfile",
        "pattern": "^FROM nixos/nix:(?P<version>\\d+\\.\\d+\\.\\d+)$",
        "type": "file-regex"
      },
      "remote": "nixos-nix",
      "release": {
        "description": "Latest Nix source release tag",
        "mode": "advisory",
        "tag_pattern": "^refs/tags/(?P<version>\\d+\\.\\d+(?:\\.\\d+)?)$"
      }
    }
  ],
  "defaults": {
    "unavailable": "warn"
  }
}
