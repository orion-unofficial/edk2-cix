{
  "description": "Supported source-tree build matrix for EDK2-CIX firmware branches. This records source combinations; it does not claim byte-identical firmware output.",
  "documented_make_variables": {
    "build_output": {
      "V": [
        "0",
        "1"
      ]
    },
    "delegated_firmware_build": {
      "FIRMWARE_BOARD": [
        "O6",
        "O6N"
      ],
      "FIRMWARE_DISTRO": {
        "allowed": [
          "bookworm",
          "trixie"
        ],
        "defaults": {
          "edk2-stable202208": "bookworm",
          "post-edk2-stable202208": "trixie"
        }
      },
      "FIRMWARE_TARGET": [
        "RELEASE",
        "DEBUG"
      ]
    },
    "install": {
      "FORCE": [
        "0",
        "1"
      ],
      "INSTALL_ROOT": "path; defaults to /boot/efi",
      "INSTALL_SOURCE": "optional staged payload path or path relative to dist/firmware"
    },
    "source_selection": {
      "FORCE": [
        "0",
        "1"
      ],
      "PERSIST": [
        "0",
        "1"
      ],
      "REBUILD": [
        "0",
        "1"
      ],
      "RELEASE": {
        "accepted_forms": [
          "short name under source/release/",
          "full source/release/... branch name"
        ],
        "values": "expanded source_variants plus special_source_variants"
      }
    }
  },
  "edk2_releases": [
    {
      "build_policy": "edk2-stable202208",
      "edk2_ref": "edk2-stable202208",
      "release": "202208"
    },
    {
      "build_policy": "post-edk2-stable202208",
      "edk2_ref": "edk2-stable202211",
      "release": "202211"
    },
    {
      "build_policy": "post-edk2-stable202208",
