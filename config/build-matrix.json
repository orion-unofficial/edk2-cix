  "schema_version": 1,
  "source_variants": [
    {
      "branch_template": "source/release/upstream/edk2-{release}/radxa-1.2.1",
      "description": "Upstream EDK2 component skeleton plus the Radxa 1.2.1 vendor delta carried to the selected EDK2 release.",
      "name": "upstream-radxa-1.2.1",
      "releases": "all",
      "required_ref_templates": [
        "source/base/rendered/edk2-stable{release}",
        "source/base/edk2/edk2/edk2-stable{release}",
        "source/base/edk2/edk2-platforms/edk2-stable{release}",
        "source/base/edk2/edk2-non-osi/edk2-stable{release}",
        "source/delta/radxa/1.2.1/edk2-stable{release}"
      ]
    },
    {
      "branch_template": "source/release/vendor/edk2-{release}/cix-1.2/radxa-1.2.1",
      "description": "Radxa-carried EDK2 tree plus CIX 1.2 TF-A and OP-TEE component bundle content.",
      "name": "vendor-cix-1.2-radxa-1.2.1",
      "releases": "all",
      "required_ref_templates": [
        "source/release/upstream/edk2-{release}/radxa-1.2.1",
        "source/component/cix/1.2/tf-a",
        "source/component/cix/1.2/op-tee"
      ]
    },
    {
      "branch_template": "source/release/custom/edk2-{release}/cix-1.2/radxa-1.2.1/local",
      "description": "Vendor CIX/Radxa tree plus the compatible local delta for the selected EDK2 release.",
      "name": "custom-cix-1.2-radxa-1.2.1-local",
      "releases": "all",
      "required_ref_templates": [
        "source/release/vendor/edk2-{release}/cix-1.2/radxa-1.2.1",
        "source/unofficial/edk2-stable{release}",
        "source/delta/local/edk2-stable{release}"
      ]
    },
    {
      "alias_of_template": "source/release/custom/edk2-{release}/cix-1.2/radxa-1.2.1/local",
      "branch_template": "source/release/custom/edk2-{release}/cix-1.2/radxa-1.2.1/local-1.2.1",
      "description": "Named local-version alias for the custom CIX/Radxa tree.",
      "name": "custom-cix-1.2-radxa-1.2.1-local-1.2.1",
      "releases": "all",
      "required_ref_templates": [
        "source/release/vendor/edk2-{release}/cix-1.2/radxa-1.2.1",
        "source/unofficial/edk2-stable{release}",
        "source/delta/local/edk2-stable{release}"
      ]
    }
  ],
  "special_source_variants": [
    {
      "branch": "source/release/custom/edk2-202208/radxa-1.2.1/local",
      "description": "EDK2 202208 Radxa-only local compatibility branch used for exact Radxa 1.2.1 qualification.",
      "name": "custom-radxa-1.2.1-local",
      "release": "202208",
      "required_refs": [
        "source/release/upstream/edk2-202208/radxa-1.2.1",
        "source/unofficial/edk2-stable202208",
        "source/delta/local/edk2-stable202208-radxa-1.2.1"
      ]
    },
    {
      "alias_of": "source/release/custom/edk2-202208/radxa-1.2.1/local",
      "branch": "source/release/custom/edk2-202208/radxa-1.2.1/local-1.2.1",
      "description": "Named local-version alias for the EDK2 202208 Radxa-only local compatibility branch.",
      "name": "custom-radxa-1.2.1-local-1.2.1",
      "release": "202208",
      "required_refs": [
        "source/release/upstream/edk2-202208/radxa-1.2.1",
        "source/unofficial/edk2-stable202208",
        "source/delta/local/edk2-stable202208-radxa-1.2.1"
      ]
    }
  ]
}
