      "release": "202302"
    },
    {
      "build_policy": "post-edk2-stable202208",
      "edk2_ref": "edk2-stable202305",
      "release": "202305"
    },
    {
      "build_policy": "post-edk2-stable202208",
      "edk2_ref": "edk2-stable202308",
      "release": "202308"
    },
    {
      "build_policy": "post-edk2-stable202208",
      "edk2_ref": "edk2-stable202311",
